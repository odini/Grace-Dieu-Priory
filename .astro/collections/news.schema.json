{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "publishDate": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "default": "Friends of Grace Dieu Priory",
      "type": "string"
    },
    "category": {
      "default": "announcement",
      "type": "string",
      "enum": [
        "announcement",
        "milestone",
        "discovery",
        "conservation",
        "press"
      ]
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "image": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "summary",
    "publishDate"
  ]
}