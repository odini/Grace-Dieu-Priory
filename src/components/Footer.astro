---
import { ExternalLink, ShieldAlert, Heart, Trash2, Dog, Sparkles } from 'lucide-astro';

const quickLinks = [
  { label: 'Plan Your Visit', href: '/visit' },
  { label: 'Priory History', href: '/history' },
  { label: 'Walks & Talks', href: '/walks-and-talks' },
  { label: 'Events Calendar', href: '/events' },
  { label: 'Latest News', href: '/news' },
  { label: 'Photo Gallery', href: '/gallery' },
  { label: 'Publications & Bookstore', href: '/shop' },
  { label: 'Volunteer & Join Us', href: '/get-involved' },
  { label: 'About the Charity', href: '/about' },
  { label: 'Contact Trustees', href: '/contact' },
  { label: 'Accessibility Statement', href: '/accessibility' },
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Design System', href: '/style-guide' },
];
---

<footer class="bg-ivy-green text-parchment-light border-t border-ivy-green-dark selection:bg-candle-gold selection:text-deep-ink">
  {/* Main Footer Container */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
      {/* Col 1: Identity & Charity Status (4 cols) */}
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-10 text-candle-gold shrink-0" aria-hidden="true">
            <svg viewBox="0 0 36 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
              <path d="M4 42V20C4 10 18 2 18 2C18 2 32 10 32 20V42" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M9 42V22C9 14 18 8 18 8C18 8 27 14 27 22V42" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" opacity="0.85" />
              <path d="M18 8V28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </div>
          <div>
            <div class="font-serif font-bold text-2xl tracking-[0.06em] uppercase text-white leading-tight">
              Grace Dieu Priory
            </div>
            <div class="text-[11px] font-sans font-medium uppercase tracking-[0.16em] text-candle-gold">
              Augustinian Canonesses · c. 1239
            </div>
          </div>
        </div>

        <p class="font-serif text-lg sm:text-xl italic text-parchment font-medium leading-relaxed">
          "Free to visit, cared for by volunteers for over 20 years."
        </p>

        <p class="text-sm text-parchment/80 leading-relaxed font-sans max-w-sm">
          Managed by The Friends of Grace Dieu Priory, a volunteer-run body dedicated to conserving the 13th-century ruins and keeping the site open to the public without statutory funding.
        </p>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-ivy-green-dark/60 border border-candle-gold/30 text-xs font-semibold text-candle-gold-light">
          <span>Registered Charity No. 1117921</span>
        </div>
      </div>

      {/* Col 2: Navigation Links (3 cols) */}
      <div class="lg:col-span-3 space-y-4">
        <h3 class="font-serif font-bold text-lg text-white uppercase tracking-wider border-b border-candle-gold/30 pb-2">
          Explore the Site
        </h3>
        <ul class="space-y-2 text-sm font-sans list-none p-0 m-0">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-parchment/80 hover:text-white hover:underline transition-colors no-underline inline-flex items-center gap-1.5 py-0.5"
                >
                  <span class="text-candle-gold/60 text-xs">›</span>
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Col 3: Charnwood Forest Geopark & Social (2 cols) */}
      <div class="lg:col-span-2 space-y-4">
        <h3 class="font-serif font-bold text-lg text-white uppercase tracking-wider border-b border-candle-gold/30 pb-2">
          Partnership
        </h3>

        <div class="space-y-3 text-xs text-parchment/85 font-sans leading-relaxed">
          <div class="bg-card-surface/10 p-2.5 rounded-lg border border-white/10 flex items-center justify-center">
            <img
              src="/images/Charnwood Forest Geopark Logo.jpg"
              alt="Charnwood Forest Geopark Logo"
              class="h-12 w-auto object-contain rounded brightness-105"
              loading="lazy"
            />
          </div>
          <p class="m-0 text-parchment/90">
            <strong>Official Partner:</strong> Charnwood Forest Geopark, collaborating as our regional landscape strives toward UNESCO Global Geopark status.
          </p>
        </div>

        <div class="pt-2">
          <a
            href="https://www.facebook.com/gracedieupriory"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs font-semibold text-candle-gold hover:text-white transition-colors no-underline py-1"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>facebook.com/gracedieupriory</span>
            <ExternalLink class="w-3 h-3 text-candle-gold/70" />
          </a>
        </div>
      </div>

      {/* Col 4: Mandatory Visitor Reminders Box (3 cols) */}
      <div class="lg:col-span-3 space-y-4">
        <h3 class="font-serif font-bold text-lg text-white uppercase tracking-wider border-b border-candle-gold/30 pb-2">
          Visitor Code
        </h3>

        <div class="bg-ivy-green-dark/70 rounded-xl p-4 border border-candle-gold/30 text-xs font-sans space-y-3.5 text-parchment/90 shadow-inner">
          <div class="flex items-start gap-2.5">
            <Trash2 class="w-4 h-4 text-candle-gold shrink-0 mt-0.5" aria-hidden="true" />
            <div>
              <strong class="text-white block mb-0.5">Leave No Trace</strong>
              <span>Please take all of your litter home with you. There are no public waste bins on the ancient monument ruins.</span>
            </div>
          </div>

          <div class="flex items-start gap-2.5 pt-2 border-t border-white/10">
            <Dog class="w-4 h-4 text-candle-gold shrink-0 mt-0.5" aria-hidden="true" />
            <div>
              <strong class="text-white block mb-0.5">Dog Walkers</strong>
              <span>Dogs welcome on leads. A dedicated bin is located at the <strong>Bull's Head car park</strong> for dog litter bags (strictly none on-site).</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Dedicated Legal Disclaimer: Strictly Prohibiting Paranormal Events */}
    <div class="mt-12 pt-6 border-t border-ivy-green-dark/80">
      <div class="rounded-lg bg-heritage-burgundy/25 border border-heritage-burgundy/40 p-4 text-center sm:text-left flex flex-col sm:flex-row items-center gap-3">
        <ShieldAlert class="w-5 h-5 text-candle-gold shrink-0" aria-hidden="true" />
        <div class="text-xs sm:text-sm font-sans text-parchment/95">
          <strong class="text-white">Strict Site Policy:</strong> Paranormal events and ghost walks are expressly forbidden by the Grace Dieu Priory Trust across the entire priory site and surrounding lands.
        </div>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-sans text-parchment/70">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-4 gap-y-1">
        <p class="m-0">
          © {new Date().getFullYear()} The Friends of Grace Dieu Priory. Registered Charity No. 1117921.
        </p>
        <span class="text-candle-gold/60 hidden sm:inline">·</span>
        <a href="/privacy" class="text-parchment/75 hover:text-white hover:underline transition-colors no-underline">
          Privacy Policy
        </a>
        <span class="text-candle-gold/60">·</span>
        <a href="/accessibility" class="text-parchment/75 hover:text-white hover:underline transition-colors no-underline">
          Accessibility Statement
        </a>
      </div>

      <div class="flex items-center gap-4 text-center sm:text-right">
        <span>Site Owned by The Grace Dieu Priory Trust</span>
        <span class="text-candle-gold">·</span>
        <span>Thringstone, Leicestershire</span>
      </div>
    </div>
  </div>
</footer>
