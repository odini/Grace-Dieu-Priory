---
interface Props {
  tag?: 'h1' | 'h2' | 'h3' | 'h4';
  title?: string;
  subtitle?: string;
  eyebrow?: string;
  align?: 'left' | 'center' | 'right';
  withDivider?: boolean;
  class?: string;
}

const {
  tag: Tag = 'h2',
  title,
  subtitle,
  eyebrow,
  align = 'left',
  withDivider = true,
  class: className = '',
} = Astro.props;

const alignmentClasses = {
  left: 'text-left items-start',
  center: 'text-center items-center mx-auto',
  right: 'text-right items-end ml-auto',
}[align];

const dividerAlignmentClasses = {
  left: 'mr-auto',
  center: 'mx-auto',
  right: 'ml-auto',
}[align];

// Size variations based on semantic level
const headingSizes = {
  h1: 'text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.15]',
  h2: 'text-3xl sm:text-4xl lg:text-4.5xl leading-[1.2]',
  h3: 'text-2xl sm:text-3xl leading-[1.25]',
  h4: 'text-xl sm:text-2xl leading-[1.3]',
}[Tag];
---

<div class={`flex flex-col ${alignmentClasses} ${className} max-w-4xl`}>
  {
    eyebrow && (
      <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold tracking-widest uppercase text-heritage-burgundy mb-2">
        <span class="inline-block w-2 h-2 rounded-full bg-candle-gold" aria-hidden="true"></span>
        {eyebrow}
      </span>
    )
  }

  <Tag class={`font-serif font-bold text-deep-ink ${headingSizes}`}>
    {title || <slot />}
  </Tag>

  {
    withDivider && (
      <div
        class={`mt-3.5 mb-2.5 flex items-center gap-2 ${dividerAlignmentClasses}`}
        aria-hidden="true"
      >
        <span class="h-[1.5px] w-12 bg-candle-gold rounded-full"></span>
        <span class="w-1.5 h-1.5 rotate-45 bg-candle-gold"></span>
        <span class="h-[1.5px] w-6 bg-candle-gold/60 rounded-full"></span>
      </div>
    )
  }

  {
    subtitle && (
      <p class="text-base sm:text-lg text-deep-ink-muted leading-relaxed mt-2 max-w-2xl font-normal">
        {subtitle}
      </p>
    )
  }
</div>
