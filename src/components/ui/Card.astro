---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'article' | 'section' | 'li' | 'a';
  href?: string;
  hover?: boolean;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  borderAccent?: 'none' | 'ivy' | 'burgundy' | 'gold';
  class?: string;
}

const {
  as: Component = 'div',
  href,
  hover = true,
  padding = 'md',
  borderAccent = 'none',
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : Component;

// Padding scales
const paddingClasses = {
  none: 'p-0',
  sm: 'p-4 sm:p-5',
  md: 'p-6 sm:p-7',
  lg: 'p-8 sm:p-10',
}[padding];

// Hover animations and elevation
const hoverClasses = hover
  ? 'transition-all duration-300 hover:-translate-y-1 hover:shadow-stone-hover hover:border-weathered-stone/90'
  : '';

// Accent top border (heritage detailing)
const accentClasses = {
  none: '',
  ivy: 'border-t-4 border-t-ivy-green',
  burgundy: 'border-t-4 border-t-heritage-burgundy',
  gold: 'border-t-4 border-t-candle-gold',
}[borderAccent];

const baseClasses =
  'block relative bg-card-surface rounded-xl border border-weathered-stone/70 shadow-stone text-deep-ink overflow-hidden';

const clickableClasses = href ? 'no-underline cursor-pointer group' : '';

const computedClasses = [
  baseClasses,
  paddingClasses,
  hoverClasses,
  accentClasses,
  clickableClasses,
  className,
]
  .filter(Boolean)
  .join(' ');
---

<Tag href={href} class={computedClasses} {...rest}>
  <slot />
</Tag>
