---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'article' | 'section' | 'li' | 'a';
  href?: string;
  hover?: boolean;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  borderAccent?: 'none' | 'ivy' | 'burgundy' | 'gold';
  class?: string;
}

const {
  as: Component = 'div',
  href,
  hover = true,
  padding = 'md',
  borderAccent = 'none',
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : Component;

// Padding scales
const paddingClasses = {
  none: 'p-0',
  sm: 'p-4 sm:p-5',
  md: 'p-6 sm:p-7',
  lg: 'p-8 sm:p-10',
}[padding];

// Hover animations and elevation
const hoverClasses = hover
  ? 'hover:shadow-[0_8px_24px_rgba(0,0,0,0.06)] hover:border-[#D9D4C7] hover:-translate-y-0.5 transition-all duration-200'
  : '';

// Uniform, natural perimeter baseline
const baseClasses =
  'block relative bg-white rounded-xl border border-[#D9D4C7]/60 shadow-[0_2px_8px_rgba(0,0,0,0.03)] text-[#1E211E] overflow-hidden';

const clickableClasses = href ? 'no-underline cursor-pointer group' : '';

const computedClasses = [
  baseClasses,
  paddingClasses,
  hoverClasses,
  clickableClasses,
  className,
]
  .filter(Boolean)
  .join(' ');
---

<Tag href={href} class={computedClasses} {...rest}>
  <slot />
</Tag>
