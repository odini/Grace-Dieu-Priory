---
import { Info, AlertTriangle, AlertOctagon, X, ArrowRight } from 'lucide-astro';

interface Props {
  id?: string;
  title: string;
  message?: string;
  severity?: 'info' | 'warning' | 'critical';
  expiresOn?: string | Date;
  dismissible?: boolean;
  actionLink?: {
    url: string;
    text: string;
  };
  class?: string;
}

const {
  id = 'banner-notice',
  title,
  message,
  severity = 'info',
  expiresOn,
  dismissible = true,
  actionLink,
  class: className = '',
} = Astro.props;

// Date expiration evaluation
let isExpired = false;
if (expiresOn) {
  const expiryDate = new Date(expiresOn);
  // Compare against end of specified day (23:59:59) if simple YYYY-MM-DD
  if (typeof expiresOn === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(expiresOn)) {
    expiryDate.setHours(23, 59, 59, 999);
  }
  const now = new Date();
  if (now.getTime() > expiryDate.getTime()) {
    isExpired = true;
  }
}

// Visual styles by severity matching Grace Dieu palette
const severityConfig = {
  info: {
    container: 'bg-[#FAF8F5] border-[#D9D4C7]/80 text-deep-ink shadow-sm hover:shadow-md',
    badge: 'bg-ivy-green/10 text-ivy-green border-ivy-green/20',
    iconColor: 'text-ivy-green',
    icon: Info,
  },
  warning: {
    container: 'bg-[#FCF9F2] border-candle-gold/40 text-deep-ink shadow-sm hover:shadow-md',
    badge: 'bg-candle-gold/15 text-[#735412] border-candle-gold/30',
    iconColor: 'text-[#8C6B1C]',
    icon: AlertTriangle,
  },
  critical: {
    container: 'bg-[#FBF4F5] border-heritage-burgundy/30 text-deep-ink shadow-sm hover:shadow-md',
    badge: 'bg-heritage-burgundy/10 text-heritage-burgundy border-heritage-burgundy/20',
    iconColor: 'text-heritage-burgundy',
    icon: AlertOctagon,
  },
};

const current = severityConfig[severity];
const IconComponent = current.icon;
const storageKey = `gdp-notice-dismissed-${id}`;
---

{
  !isExpired && (
    <div
      id={`notice-${id}`}
      data-notice-id={id}
      data-storage-key={storageKey}
      data-dismissible={dismissible ? 'true' : 'false'}
      class={`notice-banner relative rounded-xl border p-5 sm:p-6 transition-all duration-300 ${current.container} ${className}`}
      role="alert"
    >
      <div class="flex items-start gap-3.5 sm:gap-4">
        {/* Leading Icon */}
        <div class={`shrink-0 mt-0.5 ${current.iconColor}`} aria-hidden="true">
          <IconComponent class="w-5 h-5 sm:w-6 sm:h-6" />
        </div>

        {/* Content Body */}
        <div class="flex-1 min-w-0 pr-6">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class={`inline-block px-2 py-0.5 rounded text-xs font-semibold uppercase tracking-wider border ${current.badge}`}>
              {severity === 'critical' ? 'Urgent Policy' : severity === 'warning' ? 'Notice' : 'Update'}
            </span>
            <h3 class="font-serif font-bold text-base sm:text-lg text-deep-ink m-0">
              {title}
            </h3>
          </div>

          <div class="text-sm sm:text-base text-deep-ink-muted leading-relaxed">
            {message ? <p class="m-0">{message}</p> : <slot />}
          </div>

          {actionLink && (
            <div class="mt-3">
              <a
                href={actionLink.url}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-heritage-burgundy hover:text-heritage-burgundy-hover hover:underline transition-colors no-underline group"
              >
                <span>{actionLink.text}</span>
                <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
              </a>
            </div>
          )}
        </div>

        {/* Dismiss Button */}
        {dismissible && (
          <button
            type="button"
            class="notice-dismiss-btn shrink-0 p-1 rounded-md text-deep-ink-light hover:text-deep-ink hover:bg-weathered-stone/40 focus:outline-none focus:ring-2 focus:ring-candle-gold transition-colors -mr-1 -mt-1 cursor-pointer"
            aria-label="Dismiss notice"
          >
            <X class="w-4 h-4" />
          </button>
        )}
      </div>
    </div>
  )
}

<script>
  // Client-side script handling localStorage persistence for dismissed notices
  function initNotices() {
    document.querySelectorAll<HTMLElement>('.notice-banner[data-dismissible="true"]').forEach((banner) => {
      const storageKey = banner.dataset.storageKey;
      if (storageKey && localStorage.getItem(storageKey) === 'true') {
        banner.style.display = 'none';
        return;
      }

      const dismissBtn = banner.querySelector<HTMLButtonElement>('.notice-dismiss-btn');
      if (dismissBtn && storageKey) {
        dismissBtn.addEventListener('click', () => {
          banner.style.opacity = '0';
          banner.style.transform = 'translateY(-4px)';
          setTimeout(() => {
            banner.style.display = 'none';
            localStorage.setItem(storageKey, 'true');
          }, 200);
        });
      }
    });
  }

  // Initialize on load and on Astro page transitions
  initNotices();
  document.addEventListener('astro:page-load', initNotices);
</script>
