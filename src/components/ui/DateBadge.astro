---
interface Props {
  date: Date | string;
  size?: 'sm' | 'md' | 'lg';
  variant?: string; // Kept for backwards compatibility
  showYear?: boolean;
  showWeekday?: boolean;
  class?: string;
}

const {
  date,
  size = 'md',
  showYear = false,
  showWeekday = false,
  class: className = '',
} = Astro.props;

const dateObj = typeof date === 'string' ? new Date(date) : date;

// Safe date formatting helpers
const monthName = dateObj.toLocaleDateString('en-GB', { month: 'short' }).toUpperCase();
const dayNum = dateObj.toLocaleDateString('en-GB', { day: 'numeric' });
const yearNum = dateObj.toLocaleDateString('en-GB', { year: 'numeric' });
const weekdayName = dateObj.toLocaleDateString('en-GB', { weekday: 'short' });
---

<div
  class={`inline-flex flex-col items-center justify-center select-none shrink-0 w-16 min-w-[64px] ${className}`}
  datetime={dateObj.toISOString()}
>
  {/* Weekday badge (optional) */}
  {
    showWeekday && (
      <span class="w-full bg-[#FAF8F5] border-t border-x border-[#D9D4C7] rounded-t-md text-[10px] uppercase font-semibold text-[#5C645E] py-0.5 text-center leading-tight">
        {weekdayName}
      </span>
    )
  }

  {/* Header month bar */}
  <span
    class={`w-full bg-[#2F4A3A] text-[#F6F1E7] text-[10px] font-semibold tracking-wider uppercase py-1 text-center leading-none ${showWeekday ? '' : 'rounded-t-md'}`}
  >
    {monthName}
  </span>

  {/* Day container */}
  <div class="w-full bg-[#FAF8F5] border-x border-b border-[#D9D4C7] rounded-b-md py-1.5 px-3 text-center flex flex-col items-center justify-center">
    {/* Day number */}
    <span class="text-xl font-serif font-bold text-[#1E211E] leading-none">
      {dayNum}
    </span>

    {/* Year label */}
    {
      showYear && (
        <span class="text-[10px] text-[#5C645E] leading-none mt-1 pt-1 border-t border-[#D9D4C7]/60 w-full block text-center">
          {yearNum}
        </span>
      )
    }
  </div>
</div>
