---
import { getCollection } from 'astro:content';
import { Megaphone, X, ArrowRight, AlertTriangle } from 'lucide-astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Fetch all notices from collection
const allNotices = await getCollection('notices');
const now = new Date();

// Filter for active, non-expired notices
const activeNotices = allNotices.filter((notice) => {
  if (notice.data.active === false) return false;

  const expiry = notice.data.expiresOn || notice.data.expiresAt;
  if (expiry) {
    const expiryDate = new Date(expiry);
    // If simple YYYY-MM-DD date, compare to end of day
    if (typeof expiry === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(expiry)) {
      expiryDate.setHours(23, 59, 59, 999);
    }
    if (now.getTime() > expiryDate.getTime()) {
      return false;
    }
  }

  return true;
});

// Priority sort: pinned items first
activeNotices.sort((a, b) => {
  if (a.data.pinned && !b.data.pinned) return -1;
  if (!a.data.pinned && b.data.pinned) return 1;
  return 0;
});

// Select the primary announcement (e.g. AGM notice)
const currentNotice = activeNotices.length > 0 ? activeNotices[0] : null;
const noticeId = currentNotice ? currentNotice.id : 'site-announcement';
const storageKey = `gdp-notice-dismissed-${noticeId}`;
---

{
  currentNotice && (
    <aside
      id="site-top-notice"
      data-storage-key={storageKey}
      class={`site-top-banner relative bg-[#243A2D] text-parchment-light border-b border-candle-gold/40 text-xs sm:text-sm px-4 py-3 sm:px-6 transition-all duration-300 z-30 ${className}`}
      aria-label="Important Announcement"
      role="region"
    >
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-3 relative pr-8 sm:pr-0">
        <div class="flex items-start sm:items-center gap-2.5 flex-1 min-w-0">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-candle-gold/20 text-candle-gold self-start mt-0.5 shrink-0">
            <Megaphone class="w-3.5 h-3.5" aria-hidden="true" />
          </span>

          <div class="flex-1 min-w-0 text-xs sm:text-sm leading-snug">
            <span class="font-semibold text-candle-gold uppercase tracking-wider text-[11px] inline-block mr-1.5 shrink-0">
              {currentNotice.data.title}:
            </span>
            <span class="font-normal text-parchment/95 whitespace-normal line-clamp-2 sm:line-clamp-none">
              {currentNotice.data.shortNotice || currentNotice.body || currentNotice.data.title}
            </span>
            {currentNotice.data.actionLink && (
              <a
                href={currentNotice.data.actionLink.url}
                class="inline-flex items-center gap-1 font-semibold text-candle-gold hover:text-white underline underline-offset-2 ml-1.5 shrink-0 text-xs transition-colors"
              >
                <span>{currentNotice.data.actionLink.text}</span>
                <ArrowRight class="w-3 h-3" aria-hidden="true" />
              </a>
            )}
          </div>
        </div>

        {currentNotice.data.dismissible && (
          <button
            type="button"
            id="site-notice-dismiss-btn"
            class="absolute right-0 top-1/2 -translate-y-1/2 sm:static sm:translate-y-0 text-parchment/70 hover:text-parchment hover:bg-white/10 p-1.5 rounded transition-colors shrink-0 cursor-pointer focus:outline-none focus:ring-1 focus:ring-candle-gold"
            aria-label="Dismiss banner notice"
          >
            <X class="w-4 h-4 sm:w-3.5 sm:h-3.5" aria-hidden="true" />
          </button>
        )}
      </div>
    </aside>
  )
}

<script>
  function setupSiteNotice() {
    const banner = document.getElementById('site-top-notice');
    if (!banner) return;

    const storageKey = banner.dataset.storageKey;
    if (storageKey && localStorage.getItem(storageKey) === 'true') {
      banner.style.display = 'none';
      return;
    }

    const dismissBtn = document.getElementById('site-notice-dismiss-btn');
    if (dismissBtn && storageKey) {
      dismissBtn.addEventListener('click', () => {
        banner.style.opacity = '0';
        banner.style.maxHeight = '0';
        banner.style.paddingTop = '0';
        banner.style.paddingBottom = '0';
        setTimeout(() => {
          banner.style.display = 'none';
          localStorage.setItem(storageKey, 'true');
        }, 250);
      });
    }
  }

  setupSiteNotice();
  document.addEventListener('astro:page-load', setupSiteNotice);
</script>
