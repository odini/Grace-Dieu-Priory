---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import {
  Eye,
  CheckCircle2,
  AlertTriangle,
  Compass,
  Dog,
  MapPin,
  HeartHandshake,
  ShieldCheck,
  Footprints,
} from 'lucide-astro';
---

<BaseLayout
  title="Accessibility Statement & Site Guide | Grace Dieu Priory"
  description="Accessibility statement for Grace Dieu Priory: WCAG 2.2 digital standards and honest physical access guidance for wheelchair users, families, and visitors with mobility requirements."
>
  {/* Hero Header */}
  <section class="bg-ivy-green-dark text-parchment-light py-16 sm:py-20 border-b border-weathered-stone/60 relative overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-candle-gold/20 text-candle-gold border border-candle-gold/40 mb-4 backdrop-blur-xs">
        <Eye class="w-3.5 h-3.5 text-candle-gold" />
        <span>Inclusion & Access Commitment</span>
      </span>

      <h1 class="font-serif font-bold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight max-w-3xl mb-4">
        Accessibility Statement
      </h1>

      <p class="text-lg sm:text-xl text-parchment/90 max-w-2xl leading-relaxed font-normal">
        We believe historic ruins and green spaces belong to everyone. Here you will find an honest appraisal of our physical site terrain and our digital web accessibility standards.
      </p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-16">
    {/* Section 1: Physical Monument Access Guide */}
    <section class="space-y-6">
      <SectionHeading
        tag="h2"
        eyebrow="On-Site Access"
        title="Physical Site Terrain & Honest Guidance"
        subtitle="Grace Dieu Priory is a scheduled ancient monument situated in natural woodland and meadowland. Please review these realistic access notes before visiting."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <Card padding="md" borderAccent="gold" class="space-y-3 bg-card-surface border-2 border-weathered-stone shadow-stone">
          <div class="w-10 h-10 rounded-xl bg-candle-gold/20 flex items-center justify-center text-candle-gold-dark">
            <Footprints class="w-5 h-5 text-[#8C6B1C]" />
          </div>
          <h3 class="font-serif font-bold text-xl text-deep-ink">Footpaths & Ground Surfaces</h3>
          <p class="text-xs sm:text-sm text-deep-ink-muted leading-relaxed m-0">
            The path from the Bull’s Head car park follows a natural woodland trail with compacted earth, gravel sections, and occasional exposed tree roots. Within the priory precinct, the ground is grass meadow with uneven, weathered stone foundation thresholds.
          </p>
        </Card>

        <Card padding="md" borderAccent="burgundy" class="space-y-3 bg-card-surface border-2 border-weathered-stone shadow-stone">
          <div class="w-10 h-10 rounded-xl bg-heritage-burgundy/10 flex items-center justify-center text-heritage-burgundy">
            <Compass class="w-5 h-5 text-heritage-burgundy" />
          </div>
          <h3 class="font-serif font-bold text-xl text-deep-ink">Wheelchairs & Pushchairs</h3>
          <p class="text-xs sm:text-sm text-deep-ink-muted leading-relaxed m-0">
            During dry summer weather, all-terrain wheelchairs and sturdy pushchairs can navigate the trail from the Bull's Head and traverse the priory grass meadow. After periods of heavy rain, woodland paths can become soft, muddy, and challenging for standard mobility aids.
          </p>
        </Card>

        <Card padding="md" borderAccent="ivy" class="space-y-3 bg-card-surface border-2 border-weathered-stone shadow-stone">
          <div class="w-10 h-10 rounded-xl bg-ivy-green/10 flex items-center justify-center text-ivy-green">
            <Dog class="w-5 h-5 text-ivy-green" />
          </div>
          <h3 class="font-serif font-bold text-xl text-deep-ink">Assistance Dogs Welcome</h3>
          <p class="text-xs sm:text-sm text-deep-ink-muted leading-relaxed m-0">
            Trained guide dogs, hearing dogs, and medical assistance animals are warmly welcome across the entire site and ruins at all times. Fresh water bowls are available at the Bull's Head patron entrance.
          </p>
        </Card>

        <Card padding="md" borderAccent="none" class="space-y-3 bg-card-surface border-2 border-weathered-stone shadow-stone">
          <div class="w-10 h-10 rounded-xl bg-weathered-stone/60 flex items-center justify-center text-deep-ink">
            <AlertTriangle class="w-5 h-5 text-deep-ink" />
          </div>
          <h3 class="font-serif font-bold text-xl text-deep-ink">Facilities & Lighting</h3>
          <p class="text-xs sm:text-sm text-deep-ink-muted leading-relaxed m-0">
            As an open-air medieval ruin, there are no public toilets, running water, or artificial floodlights on the monument grounds. The nearest accessible customer facilities are situated at the Bull’s Head pub during opening hours.
          </p>
        </Card>
      </div>

      {/* Forthcoming Footbridge Callout */}
      <div class="p-5 sm:p-6 rounded-2xl bg-[#FCFAF6] border-2 border-candle-gold/40 shadow-xs flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="w-10 h-10 rounded-xl bg-candle-gold/20 flex items-center justify-center text-candle-gold-dark shrink-0">
          <CheckCircle2 class="w-5 h-5 text-[#8C6B1C]" />
        </div>
        <div class="space-y-1">
          <h4 class="font-serif font-bold text-lg text-deep-ink m-0">
            Forthcoming Improvement: Accessible Pedestrian Footbridge
          </h4>
          <p class="text-xs sm:text-sm text-deep-ink-muted leading-relaxed m-0">
            Following the Trust’s freehold purchase in 2024, plans are underway to construct a dedicated, step-free pedestrian footbridge linking Rusty Mary’s field directly into the priory cloister precinct, significantly improving step-free accessibility.
          </p>
        </div>
      </div>
    </section>

    {/* Section 2: Digital Web Accessibility (WCAG 2.2) */}
    <section class="space-y-6">
      <SectionHeading
        tag="h2"
        eyebrow="Digital Standards"
        title="Web Accessibility Standards (WCAG 2.2)"
        subtitle="We strive to provide a website that meets Level AA conformance of the W3C Web Content Accessibility Guidelines (WCAG 2.2), with several criteria meeting Level AAA."
      />

      <div class="p-6 sm:p-8 rounded-2xl bg-card-surface border-2 border-weathered-stone shadow-stone space-y-5 text-deep-ink">
        <div class="space-y-2">
          <h3 class="font-serif font-bold text-xl text-deep-ink m-0">
            Design & Engineering Safeguards
          </h3>
          <p class="text-xs sm:text-sm text-deep-ink-muted leading-relaxed m-0">
            This website has been built from the ground up with accessibility as a first-class requirement:
          </p>
        </div>

        <ul class="space-y-3 text-xs sm:text-sm text-deep-ink-muted list-none p-0 m-0">
          <li class="flex items-start gap-3">
            <CheckCircle2 class="w-4 h-4 text-ivy-green shrink-0 mt-0.5" />
            <span><strong>High Contrast Color Tokens:</strong> Deep Ivy Green (<code>#2F4A3A</code>) on Parchment (<code>#F6F1E7</code>) yields a <strong>7.14:1 contrast ratio</strong>, exceeding WCAG AAA standards for normal body text.</span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle2 class="w-4 h-4 text-ivy-green shrink-0 mt-0.5" />
            <span><strong>Readable Base Typography:</strong> Body copy is styled at a minimum base of <strong>18px</strong> in Source Sans 3 with generous line heights to facilitate effortless reading for older visitors.</span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle2 class="w-4 h-4 text-ivy-green shrink-0 mt-0.5" />
            <span><strong>Keyboard Navigability & Focus Rings:</strong> Every interactive link, button, and form control possesses visible high-contrast focus rings and supports full tab keyboard navigation.</span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle2 class="w-4 h-4 text-ivy-green shrink-0 mt-0.5" />
            <span><strong>Skip-to-Content:</strong> A persistent skip link is provided at the very top of each page for screen reader and keyboard users to bypass navigation menus.</span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle2 class="w-4 h-4 text-ivy-green shrink-0 mt-0.5" />
            <span><strong>Descriptive Text Equivalents:</strong> All photographic assets feature meaningful, contextual <code>alt</code> attributes; purely decorative vector icons are marked with <code>aria-hidden="true"</code>.</span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle2 class="w-4 h-4 text-ivy-green shrink-0 mt-0.5" />
            <span><strong>Accessible Modals:</strong> Lightbox viewers and booking dialogs maintain ARIA focus management, trap tab navigation within the active overlay, and dismiss cleanly on the <code>Escape</code> key.</span>
          </li>
        </ul>
      </div>
    </section>

    {/* Section 3: Feedback & Special Arrangements */}
    <section class="p-6 sm:p-8 rounded-2xl bg-parchment-light border border-weathered-stone/80 space-y-4">
      <div class="flex items-center gap-2">
        <HeartHandshake class="w-5 h-5 text-heritage-burgundy" />
        <h3 class="font-serif font-bold text-xl text-deep-ink m-0">
          Accessibility Feedback & Tailored Visits
        </h3>
      </div>

      <p class="text-xs sm:text-sm text-deep-ink-muted leading-relaxed m-0">
        If you experience any difficulty accessing content on this website or wish to discuss tailored arrangements for a school group or visitor with limited mobility, please contact Malcolm Allsop or David Whitt. We will gladly advise on parking proximity and optimal route access.
      </p>

      <div class="pt-2 flex flex-wrap gap-4">
        <Button
          variant="primary"
          size="sm"
          href="/contact"
          class="font-bold"
        >
          Contact Accessibility Leads ›
        </Button>
        <Button
          variant="outline"
          size="sm"
          href="/style-guide"
          class="font-bold"
        >
          View WCAG Compliance Matrix ›
        </Button>
      </div>
    </section>
  </div>
</BaseLayout>
