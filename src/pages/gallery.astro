      'The cloisters transformed into a vibrant 1485 living history camp with The Ferrers Household and The Friends of the Thomas Grey Household demonstrating authentic weaponry, leathercraft, and archery.',
  },
  {
    id: 'priory-foundations',
    title: 'Ruins Foundations & East Cloister Walk',
    category: 'ruins',
    categoryLabel: 'Ruins & Architecture',
    tag: 'CLOISTER GARTH',
    image: '/images/priory-ruins-2.webp',
    webp: '/images/priory-ruins-2.webp',
    avif: '/images/priory-ruins-2.avif',
    thumbnail: '/images/priory-ruins-2.webp',
    width: 1800,
    height: 1200,
    alt: 'Consolidated stone foundations and cloister garth meadows of Grace Dieu Priory under open sky',
    credit: 'Grace Dieu Priory Trust',
    date: 'Summer 2026',
    description:
      'The quiet expanse of the priory cloister precinct, showing conserved foundation walls surrounded by peaceful meadowland and Charnwood trees.',
  },
  {
    id: 'geopark-partnership',
    title: 'Charnwood Forest Geopark Partnership',
    category: 'community',
    categoryLabel: 'Volunteers & Community',
    tag: 'STEWARDSHIP',
    image: '/images/Geopark presentation 2025-02-19.webp',
    webp: '/images/Geopark presentation 2025-02-19.webp',
    avif: '/images/Geopark presentation 2025-02-19.avif',
    thumbnail: '/images/Geopark presentation 2025-02-19.webp',
    width: 690,
    height: 518,
    alt: 'Presentation of official Charnwood Forest Geopark partnership certificate to volunteer trustees',
    credit: 'Charnwood Forest Geopark',
    date: 'February 2025',
    description:
      'Trustees of Grace Dieu Priory officially receiving their partner accreditation as Charnwood Forest progresses toward prestigious UNESCO Global Geopark designation.',
  },
];
---

<BaseLayout
  title="Photo & Aerial Gallery | Grace Dieu Priory"
  description="Explore drone aerial photography, ancient 800-year-old walls, historical reenactment fayres, and Charnwood woodland flora of Grace Dieu Priory."
>
  {/* Hero Header */}
  <section class="bg-ivy-green-dark text-parchment-light py-16 sm:py-20 border-b border-weathered-stone/60 relative overflow-hidden">
    <div class="absolute inset-0 opacity-25">
      <picture>
        <source srcset="/images/dji_fly_20261017_114148_0073_1792234397332_photo.avif" type="image/avif" />
        <source srcset="/images/dji_fly_20261017_114148_0073_1792234397332_photo.webp" type="image/webp" />
        <img
          src="/images/dji_fly_20261017_114148_0073_1792234397332_photo.webp"
          alt="Grace Dieu Priory ruins aerial background"
          width="2000"
          height="1500"
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
      </picture>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-candle-gold/20 text-candle-gold border border-candle-gold/40 mb-4 backdrop-blur-xs">
        <Camera class="w-3.5 h-3.5 text-candle-gold" />
        <span>Photographic Archive & Aerial Survey</span>
      </span>

      <h1 class="font-serif font-bold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight max-w-3xl mb-4">
        Visual Media Gallery
      </h1>

      <p class="text-lg sm:text-xl text-parchment/90 max-w-2xl leading-relaxed font-normal">
        From recent high-resolution drone flights over the cloister arches to newly uncovered 13th-century masonry and vivid living history reenactments.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    {/* Section 1: Interactive Category Filter Bar */}
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-weathered-stone/80 pb-4">
        <div>
          <h2 class="font-serif font-bold text-2xl text-deep-ink m-0">
            Heritage Photography
          </h2>
          <p class="text-xs sm:text-sm text-deep-ink-muted m-0 mt-0.5">
            Click any photograph to open the high-resolution lightbox with historical notes.
          </p>
        </div>

        {/* Filter Pills */}
        <div id="filter-bar" class="flex flex-wrap items-center gap-1.5" role="tablist" aria-label="Gallery category filters">
          <button
            type="button"
            class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer bg-ivy-green text-parchment-light shadow-xs"
            data-filter="all"
            role="tab"
            aria-selected="true"
          >
            All Photos ({galleryItems.length})
          </button>
          <button
            type="button"
            class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer bg-card-surface text-deep-ink border border-weathered-stone hover:bg-parchment-light"
            data-filter="ruins"
            role="tab"
            aria-selected="false"
          >
            Ruins & Architecture
          </button>
          <button
            type="button"
            class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer bg-card-surface text-deep-ink border border-weathered-stone hover:bg-parchment-light"
            data-filter="aerial"
            role="tab"
            aria-selected="false"
          >
            Aerial Landscape
          </button>
          <button
            type="button"
            class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer bg-card-surface text-deep-ink border border-weathered-stone hover:bg-parchment-light"
            data-filter="nature"
            role="tab"
            aria-selected="false"
          >
            Parkland & Woodland
          </button>
          <button
            type="button"
            class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer bg-card-surface text-deep-ink border border-weathered-stone hover:bg-parchment-light"
            data-filter="community"
            role="tab"
            aria-selected="false"
          >
            Volunteers & Community
          </button>
          <button
            type="button"
            class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer bg-card-surface text-deep-ink border border-weathered-stone hover:bg-parchment-light"
            data-filter="events"
            role="tab"
            aria-selected="false"
          >
            Living History
          </button>
        </div>
      </div>

      {/* Standardized Card Geometry Grid (Uniform 4:3 Aspect Ratios) */}
      <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 items-stretch">
        {
          galleryItems.map((item, index) => {
            return (
              <div
                class="gallery-card overflow-hidden rounded-xl border border-[#D9D4C7]/70 bg-white shadow-sm hover:shadow-md transition-all duration-200 group cursor-pointer flex flex-col justify-between"
                data-category={item.category}
                data-index={index}
                data-id={item.id}
                data-title={item.title}
                data-image={item.image}
                data-alt={item.alt}
                data-credit={item.credit}
                data-date={item.date}
                data-category-label={item.categoryLabel}
                data-description={item.description}
                role="button"
                tabindex="0"
                aria-label={`Open photo: ${item.title}`}
              >
                {/* Standardized 4:3 Image Container */}
                <div class="relative w-full aspect-[4/3] overflow-hidden bg-[#EAE6DE]">
                  <picture>
                    <source srcset={item.avif} type="image/avif" />
                    <source srcset={item.webp} type="image/webp" />
                    <img
                      src={item.thumbnail}
                      alt={item.alt}
                      width={item.width}
                      height={item.height}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>

                  {/* Clean Understated Tag Pill (Top-Left) */}
                  <span class="absolute top-3 left-3 bg-[#F6F1E7]/90 backdrop-blur-sm border border-[#D9D4C7] text-[#2F4A3A] text-[10px] uppercase tracking-[0.14em] font-medium px-2 py-0.5 rounded shadow-xs">
                    {item.tag}
                  </span>
                </div>

                {/* Streamlined Editorial Caption Footer */}
                <div class="p-3.5 flex flex-col justify-between gap-1 flex-1">
                  <h3 class="text-sm font-serif font-medium text-[#1E211E] line-clamp-1 group-hover:text-[#7A2E3A] transition-colors m-0">
                    {item.title}
                  </h3>
                  <div class="flex items-center justify-between gap-2 pt-1 border-t border-[#D9D4C7]/40 mt-auto">
                    <span class="text-xs text-[#5C645E] truncate max-w-[180px]">Credit: {item.credit}</span>
                    <span class="text-[11px] text-[#5C645E] font-medium shrink-0">{item.date}</span>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    {/* Section 2: Privacy-Preserving Aerial Drone Video Feature */}
    {/* Section 2: Privacy-Preserving Aerial Drone Video Feature */}
    <section class="rounded-2xl border border-[#D9D4C7]/80 bg-white p-6 sm:p-10 shadow-sm space-y-6">
      <div class="max-w-3xl space-y-2">
        <span class="text-xs uppercase font-mono font-bold text-candle-gold-dark tracking-wider">
          Moving Image Showcase
        </span>
        <h2 class="font-serif font-bold text-2xl sm:text-3xl text-deep-ink">
          Aerial Flight Over the Cloisters
        </h2>
        <p class="text-sm sm:text-base text-deep-ink-muted leading-relaxed m-0">
          Experience Richard Taylor’s renowned aerial drone flight capturing the ruined Augustinian cloisters, Beaumont Tudor chimney, and surrounding Grace Dieu Brook.
        </p>
      </div>

      <div class="relative rounded-2xl overflow-hidden border border-[#D9D4C7]/80 shadow-md bg-deep-ink max-w-4xl mx-auto aspect-16/9">
        {/* Click-to-load video player facade protecting visitor privacy */}
        <div id="video-facade" class="absolute inset-0 cursor-pointer group">
          <img
            src="/images/header.jpg"
            alt="Grace Dieu Priory ruins aerial flight preview thumbnail"
            class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500 opacity-80"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-deep-ink/80 via-deep-ink/30 to-deep-ink/40"></div>

          <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center text-white space-y-4">
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-candle-gold text-deep-ink flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:bg-candle-gold-light transition-all">
              <Play class="w-8 h-8 sm:w-10 sm:h-10 fill-current translate-x-0.5" />
            </div>
            <div>
              <div class="font-serif font-bold text-xl sm:text-2xl text-white">
                Play Aerial Drone Flight (4K)
              </div>
              <p class="text-xs sm:text-sm text-parchment/80 max-w-md mx-auto mt-1 m-0">
                Click to load video. No tracking cookies are loaded until you press play.
              </p>
            </div>
          </div>
        </div>

        {/* Video iframe injected on click */}
        <div id="video-container" class="hidden w-full h-full"></div>
      </div>
    </section>

    {/* Section 3: Community Photographic Contributions */}
    <section class="rounded-2xl border border-candle-gold/40 bg-[#FCFAF6] p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <div class="flex items-center gap-2">
          <Camera class="w-5 h-5 text-candle-gold-dark" />
          <h3 class="font-serif font-bold text-xl text-deep-ink m-0">
            Photographed the Priory Recently?
          </h3>
        </div>
        <p class="text-xs sm:text-sm text-deep-ink-muted leading-relaxed m-0">
          We welcome community submissions of high-quality seasonal photography, wildlife sightings, and historic snapshots of the priory. With your permission, credited photographs are featured on our website and charity calendar.
        </p>
      </div>

      <Button
        variant="outline"
        size="md"
        href="mailto:info@gracedieupriory.org.uk?subject=Photo%20Submission%20-%20Grace%20Dieu%20Priory"
        class="shrink-0 font-bold"
      >
        Submit Photos by Email ›
      </Button>
    </section>
  </div>

  {/* ACCESSIBLE LIGHTBOX MODAL */}
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-50 invisible opacity-0 transition-all duration-300 pointer-events-none flex items-center justify-center p-3 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="lightbox-title"
  >
    {/* Backdrop */}
    <div
      id="lightbox-backdrop"
      class="fixed inset-0 bg-[#141C16]/90 backdrop-blur-md transition-opacity duration-300"
      aria-hidden="true"
    ></div>

    {/* Lightbox Dialog Container */}
    <div
      id="lightbox-panel"
      class="relative w-full max-w-5xl bg-white rounded-2xl border border-[#D9D4C7] shadow-2xl overflow-hidden scale-95 transition-all duration-300 z-10 max-h-[92vh] flex flex-col"
    >
      {/* Top Header */}
      <div class="p-4 sm:p-5 border-b border-[#D9D4C7]/80 bg-[#FAF8F5] flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span
            id="lightbox-category"
            class="px-2.5 py-0.5 rounded text-[11px] font-medium tracking-[0.12em] uppercase bg-[#F4F1EA] text-[#3F4E4F] border border-[#E5E0D5]"
          ></span>
          <span id="lightbox-counter" class="text-xs font-mono text-[#5C645E]"></span>
        </div>

        <button
          type="button"
          id="lightbox-close"
          class="p-2 rounded-lg text-[#5C645E] hover:text-[#1E211E] hover:bg-[#F0ECE1] transition-colors cursor-pointer"
          aria-label="Close photo preview (Escape)"
        >
          <X class="w-6 h-6" />
        </button>
      </div>

      {/* Main Image View Area */}
      <div class="relative bg-black flex items-center justify-center overflow-hidden min-h-[300px] max-h-[60vh]">
        <img
          id="lightbox-image"
          src=""
          alt=""
          class="max-h-[60vh] max-w-full object-contain mx-auto transition-opacity duration-200"
        />

        {/* Previous Button */}
        <button
          type="button"
          id="lightbox-prev"
          class="absolute left-3 top-1/2 -translate-y-1/2 p-2.5 rounded-full bg-[#1E211E]/80 hover:bg-[#1E211E] text-white transition-all cursor-pointer shadow-lg hover:scale-105 focus:outline-none focus:ring-2 focus:ring-candle-gold"
          aria-label="Previous photograph (Left arrow)"
        >
          <ChevronLeft class="w-6 h-6" />
        </button>

        {/* Next Button */}
        <button
          type="button"
          id="lightbox-next"
          class="absolute right-3 top-1/2 -translate-y-1/2 p-2.5 rounded-full bg-[#1E211E]/80 hover:bg-[#1E211E] text-white transition-all cursor-pointer shadow-lg hover:scale-105 focus:outline-none focus:ring-2 focus:ring-candle-gold"
          aria-label="Next photograph (Right arrow)"
        >
          <ChevronRight class="w-6 h-6" />
        </button>
      </div>

      {/* Information & Credit Footer */}
      <div class="p-5 sm:p-6 bg-white border-t border-[#D9D4C7]/80 overflow-y-auto space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <h3 id="lightbox-title" class="font-serif font-bold text-xl sm:text-2xl text-[#1E211E] m-0"></h3>
          <div class="flex items-center gap-3 text-xs text-[#5C645E] shrink-0">
            <span id="lightbox-date" class="font-medium"></span>
            <span>·</span>
            <span id="lightbox-credit" class="font-medium"></span>
          </div>
        </div>

        <p id="lightbox-desc" class="text-xs sm:text-sm text-[#5C645E] leading-relaxed m-0 font-normal"></p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function setupGallery() {
    // Gallery Items data array
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.gallery-card'));
    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));

    // Lightbox Elements
    const modal = document.getElementById('lightbox-modal');
    const backdrop = document.getElementById('lightbox-backdrop');
    const panel = document.getElementById('lightbox-panel');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    const imgEl = document.getElementById('lightbox-image') as HTMLImageElement;
    const titleEl = document.getElementById('lightbox-title');
    const descEl = document.getElementById('lightbox-desc');
    const categoryEl = document.getElementById('lightbox-category');
    const creditEl = document.getElementById('lightbox-credit');
    const dateEl = document.getElementById('lightbox-date');
    const counterEl = document.getElementById('lightbox-counter');

    let currentIndex = 0;
    let visibleCards = [...cards];

    // Filter functionality
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';

        // Update button styles
        filterBtns.forEach((b) => {
          b.classList.remove('bg-ivy-green', 'text-parchment-light', 'shadow-xs');
          b.classList.add('bg-card-surface', 'text-deep-ink', 'border', 'border-weathered-stone');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('bg-ivy-green', 'text-parchment-light', 'shadow-xs');
        btn.classList.remove('bg-card-surface', 'text-deep-ink', 'border');
        btn.setAttribute('aria-selected', 'true');

        // Filter cards
        visibleCards = [];
        cards.forEach((card) => {
          const category = card.dataset.category;
          if (filter === 'all' || category === filter) {
            card.classList.remove('hidden');
            visibleCards.push(card);
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    // Lightbox modal opener
    function updateLightbox(index: number) {
      if (!visibleCards[index]) return;
      currentIndex = index;
      const card = visibleCards[currentIndex];

      if (imgEl) {
        imgEl.style.opacity = '0';
        setTimeout(() => {
          imgEl.src = card.dataset.image || '';
          imgEl.alt = card.dataset.alt || '';
          imgEl.style.opacity = '1';
        }, 150);
      }

      if (titleEl) titleEl.textContent = card.dataset.title || '';
      if (descEl) descEl.textContent = card.dataset.description || '';
      if (categoryEl) categoryEl.textContent = card.dataset.categoryLabel || '';
      if (creditEl) creditEl.textContent = `Credit: ${card.dataset.credit || 'Friends Archive'}`;
      if (dateEl) dateEl.textContent = card.dataset.date || '';
      if (counterEl) counterEl.textContent = `${currentIndex + 1} of ${visibleCards.length}`;
    }

    function openLightbox(index: number) {
      if (!modal || !panel) return;
      updateLightbox(index);

      modal.classList.remove('invisible', 'pointer-events-none');
      modal.classList.add('visible', 'pointer-events-auto');

      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        panel.classList.remove('scale-95');
        panel.classList.add('scale-100');
      }, 10);

      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!modal || !panel) return;
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      panel.classList.remove('scale-100');
      panel.classList.add('scale-95');

      setTimeout(() => {
        modal.classList.remove('visible', 'pointer-events-auto');
        modal.classList.add('invisible', 'pointer-events-none');
        document.body.style.overflow = '';
      }, 250);
    }

    function showNext() {
      if (visibleCards.length === 0) return;
      const nextIndex = (currentIndex + 1) % visibleCards.length;
      updateLightbox(nextIndex);
    }

    function showPrev() {
      if (visibleCards.length === 0) return;
      const prevIndex = (currentIndex - 1 + visibleCards.length) % visibleCards.length;
      updateLightbox(prevIndex);
    }

    // Attach card click handlers
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const idx = visibleCards.indexOf(card);
        if (idx !== -1) openLightbox(idx);
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const idx = visibleCards.indexOf(card);
          if (idx !== -1) openLightbox(idx);
        }
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (backdrop) backdrop.addEventListener('click', closeLightbox);
    if (nextBtn) nextBtn.addEventListener('click', showNext);
    if (prevBtn) prevBtn.addEventListener('click', showPrev);

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!modal || modal.classList.contains('invisible')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    });

    // Video facade setup
    const videoFacade = document.getElementById('video-facade');
    const videoContainer = document.getElementById('video-container');

    if (videoFacade && videoContainer) {
      videoFacade.addEventListener('click', () => {
        videoFacade.classList.add('hidden');
        videoContainer.classList.remove('hidden');
        videoContainer.innerHTML = `
          <iframe
            class="w-full h-full"
            src="https://www.youtube-nocookie.com/embed/G1_f6ZzcZ2k?autoplay=1"
            title="Grace Dieu Priory Aerial Flight by Richard Taylor"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        `;
      });
    }
  }

  setupGallery();
  document.addEventListener('astro:page-load', setupGallery);
</script>
