---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import {
  Camera,
  Play,
  Maximize2,
  X,
  ChevronLeft,
  ChevronRight,
  Info,
  Layers,
  Sparkles,
  Compass,
  CheckCircle2,
} from 'lucide-astro';

// Curated photo dataset with standardized aspect ratios, authentic photography, and zero baked-in banners
const galleryItems = [
  {
    id: 'standing-arches',
    title: 'Surviving Cloister Arch in Sunlight',
    category: 'ruins',
    categoryLabel: 'Ruins & Architecture',
    tag: 'ARCHITECTURE',
    image: '/images/priory-ruins.webp',
    webp: '/images/priory-ruins.webp',
    avif: '/images/priory-ruins.avif',
    thumbnail: '/images/priory-ruins.webp',
    width: 2016,
    height: 1134,
    alt: 'The standing 13th-century stone cloister arch of Grace Dieu Priory bathed in natural sunlight',
    credit: 'Grace Dieu Priory Trust',
    date: 'Summer 2026',
    description:
      'The monumental surviving Gothic south transept arch standing proudly in the Charnwood meadow, displaying eight centuries of resilient Augustinian stonework.',
