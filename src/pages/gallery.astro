    image: '/images/dji_fly_20261017_114542_0082_1792234392781_photo.webp',
    webp: '/images/dji_fly_20261017_114542_0082_1792234392781_photo.webp',
    avif: '/images/dji_fly_20261017_114542_0082_1792234392781_photo.avif',
    thumbnail: '/images/dji_fly_20261017_114542_0082_1792234392781_photo.webp',
    width: 2000,
    height: 1500,
    alt: 'Aerial view showing the proximity of the priory ruins to the historical 1794 Charnwood Forest Canal cutting and meadow',
    credit: 'Friends Aerial Survey (DJI)',
    date: 'October 2026',
    aspect: 'aspect-16/10',
    description:
      'Aerial survey showing the connection between the medieval priory precinct, Rusty Mary\'s meadow, and the late 18th-century canal cutting designed by William Jessop.',
  },
  {
    id: 'woodland-approach',
    title: 'The Atmospheric Woodland Approach',
    category: 'nature',
    categoryLabel: 'Flora & Nature',
    image: '/images/grace dieu2.webp',
    webp: '/images/grace dieu2.webp',
    avif: '/images/grace dieu2.avif',
    thumbnail: '/images/grace dieu2.webp',
    width: 1024,
    height: 768,
    alt: 'Winding woodland footpath flanked by moss-covered trees leading toward the priory ruins',
    credit: 'Friends of Grace Dieu Priory',
