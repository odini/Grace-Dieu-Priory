  {
    id: 'medieval-fayre',
    title: '20th Anniversary Medieval Fayre Encampment',
    category: 'events',
    categoryLabel: 'Living History & Events',
    image: '/images/img5.webp',
    webp: '/images/img5.webp',
    avif: '/images/img5.avif',
    thumbnail: '/images/img5.webp',
    width: 756,
    height: 567,
    alt: 'Living history reenactors in 15th-century armours and period dresses gathered in the ruined cloisters',
    credit: 'Friends of Grace Dieu Priory Archive',
    date: 'June 2026',
