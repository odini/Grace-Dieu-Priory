    thumbnail: '/images/dji_fly_20261017_113834_0065_1792234398223_photo.webp',
    width: 2000,
    height: 1500,
    alt: 'Aerial photograph showing the rich autumn woodland canopy surrounding the stone ruins of Grace Dieu Priory',
