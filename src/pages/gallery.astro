    avif: '/images/2024 BBC - Priory Wall exposed.avif',
    thumbnail: '/images/2024 BBC - Priory Wall exposed.webp',
    width: 690,
    height: 360,
    alt: 'Exposed ancient 800-year-old medieval stone wall following volunteer clearance of invasive brambles',
    credit: 'Charnwood Forest Geopark & Friends Working Party',
    date: 'May 2025',
    aspect: 'aspect-4/3',
    description:
