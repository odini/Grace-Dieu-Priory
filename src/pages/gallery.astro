    description:
      'The dappled tree canopy path that leads visitors from the Bull\'s Head car park across the brook into the peaceful solitude of the ancient monument grounds.',
  },
  {
    id: 'geopark-partnership',
    title: 'Geopark Official Partnership Presentation',
    category: 'events',
    categoryLabel: 'Living History & Events',
    image: '/images/Geopark presentation 2025-02-19.webp',
    webp: '/images/Geopark presentation 2025-02-19.webp',
    avif: '/images/Geopark presentation 2025-02-19.avif',
    thumbnail: '/images/Geopark presentation 2025-02-19.webp',
    width: 690,
    height: 518,
    alt: 'Trustees receiving the official Charnwood Forest Geopark partner certificate celebrating collaboration',
    credit: 'Charnwood Forest Geopark',
    date: 'February 2025',
    aspect: 'aspect-4/3',
    description:
      'Trustees of Grace Dieu Priory officially receiving their partner accreditation as Charnwood Forest progresses toward prestigious UNESCO Global Geopark designation.',
  },
  {
    id: 'drone-panorama',
    title: 'Panoramic Vista Across Charnwood Forest',
    category: 'aerial',
    categoryLabel: 'Aerial & Ruins',
    image: '/images/dji_fly_20261017_121424_0089_1792305669278_photo.webp',
    webp: '/images/dji_fly_20261017_121424_0089_1792305669278_photo.webp',
    avif: '/images/dji_fly_20261017_121424_0089_1792305669278_photo.avif',
    thumbnail: '/images/dji_fly_20261017_121424_0089_1792305669278_photo.webp',
    width: 2000,
    height: 1500,
    alt: 'Wide panoramic drone photography capturing the rolling Leicestershire landscape, Belton, and Thringstone',
    credit: 'Friends Aerial Survey (DJI)',
    date: 'October 2026',
    aspect: 'aspect-16/9',
    description:
      'High-altitude panorama capturing the regional geological ridge of Precambrian rocks, surrounding farmsteads, and the wooded valley of Grace Dieu.',
  },
  {
    id: 'freehold-acquisition',
    title: 'BBC News: Freehold Ownership Secured',
    category: 'archaeology',
    categoryLabel: 'Archaeology & Conservation',
    image: '/images/2024 BBC - Priory Sold.webp',
    webp: '/images/2024 BBC - Priory Sold.webp',
    avif: '/images/2024 BBC - Priory Sold.avif',
    thumbnail: '/images/2024 BBC - Priory Sold.webp',
    width: 690,
    height: 360,
    alt: 'Television broadcast report by BBC News announcing the permanent freehold acquisition of Grace Dieu Priory by the Charitable Trust',
    credit: 'BBC News East Midlands',
    date: 'November 2024',
    aspect: 'aspect-16/9',
    description:
      'Broadcast coverage documenting the milestone sale that permanently secured the freehold of the ruins and Rusty Mary\'s field in charity hands.',
  },
  {
    id: 'standing-arches',
    title: 'Transept Arches Against the Evening Sky',
    category: 'aerial',
    categoryLabel: 'Aerial & Ruins',
    image: '/images/header.webp',
    webp: '/images/header.webp',
    avif: '/images/header.avif',
    thumbnail: '/images/header.webp',
    width: 976,
    height: 266,
    alt: 'Dramatic stone Gothic arches of Grace Dieu Priory standing against a soft twilight sky',
    credit: 'Friends of Grace Dieu Priory Archive',
    date: 'Heritage Archive',
