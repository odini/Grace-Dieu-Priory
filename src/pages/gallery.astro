  {
    id: 'drone-cloisters',
    title: 'Cloister Arches & Chapter House Aerial',
    category: 'aerial',
    categoryLabel: 'Aerial Landscape',
    tag: 'AERIAL VIEW',
    image: '/images/dji_fly_20261017_114148_0073_1792234397332_photo.webp',
    webp: '/images/dji_fly_20261017_114148_0073_1792234397332_photo.webp',
    avif: '/images/dji_fly_20261017_114148_0073_1792234397332_photo.avif',
    thumbnail: '/images/dji_fly_20261017_114148_0073_1792234397332_photo.webp',
    width: 2000,
    height: 1500,
    alt: 'High-resolution drone aerial perspective looking down onto the conserved stone cloister arches of Grace Dieu Priory',
    credit: 'Friends Aerial Survey (DJI)',
    date: 'October 2026',
    description:
      'A bird\'s-eye perspective capturing the ground plan of the nunnery cloisters, chapter house footings, and Tudor conversion walls surrounded by the green Charnwood parkland.',
  },
  {
    id: 'woodland-approach',
    title: 'Woodland Footpath Along Rusty Mary’s Field',
    category: 'nature',
    categoryLabel: 'Parkland & Woodland',
    tag: 'WOODLAND TRAIL',
    image: '/images/grace dieu2.webp',
    webp: '/images/grace dieu2.webp',
    avif: '/images/grace dieu2.avif',
    thumbnail: '/images/grace dieu2.webp',
    width: 1248,
    height: 687,
    alt: 'Winding woodland footpath flanked by mature trees leading from Rusty Mary’s field toward the priory ruins',
    credit: 'Friends of Grace Dieu Priory',
    date: 'Autumn Morning',
    description:
      'The dappled tree canopy path that leads visitors from the Bull\'s Head car park and Rusty Mary’s meadow across the brook into the peaceful solitude of the ancient monument grounds.',
  },
  {
    id: 'conserved-stone',
    title: 'Conserved 13th-Century Ashlar Stonework',
    category: 'ruins',
    categoryLabel: 'Ruins & Architecture',
    tag: 'ASHLAR MASONRY',
    image: '/images/GDP Stone.webp',
    webp: '/images/GDP Stone.webp',
    avif: '/images/GDP Stone.avif',
    thumbnail: '/images/GDP Stone.webp',
    width: 2000,
    height: 1500,
    alt: 'Close-up detail of hand-dressed medieval stone masonry, mason marks, and lime-mortar joints consolidated by the Trust',
    credit: 'Trust Conservation Archive',
    date: 'Conservation Project',
    description:
      'Detailed craftsmanship in Charnwood quartzite and Swithland slate. Between 1996 and 2006, masons painstakingly repointed and pinned collapsing arches without synthetic cement.',
  },
  {
    id: 'wall-uncovered',
    title: 'Volunteer Clearance of the 800-Year-Old Wall',
    category: 'community',
    categoryLabel: 'Volunteers & Community',
    tag: 'VOLUNTEER WORK',
    image: '/images/2024 BBC - Priory Wall exposed.webp',
    webp: '/images/2024 BBC - Priory Wall exposed.webp',
    avif: '/images/2024 BBC - Priory Wall exposed.avif',
    thumbnail: '/images/2024 BBC - Priory Wall exposed.webp',
    width: 690,
    height: 360,
    alt: 'Volunteer working party clearing brambles and vegetation along the ancient boundary wall',
    credit: 'Friends & Geopark Working Party',
    date: 'May 2025',
    description:
      'During joint volunteer clearance sessions with Charnwood Forest Geopark, thick overgrowth and brambles were cleared along the southern boundary, revealing an intact length of 13th-century Augustinian walling not seen for generations.',
  },
  {
    id: 'medieval-fayre',
    title: '20th Anniversary Living History Encampment',
    category: 'events',
    categoryLabel: 'Living History & Events',
    tag: 'LIVING HISTORY',
    image: '/images/img5.webp',
    webp: '/images/img5.webp',
    avif: '/images/img5.avif',
    thumbnail: '/images/img5.webp',
    width: 756,
    height: 567,
