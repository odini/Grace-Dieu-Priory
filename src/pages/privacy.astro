---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import {
  ShieldCheck,
  Lock,
  Cookie,
  FileText,
  UserCheck,
  Mail,
  CheckCircle2,
  AlertCircle,
} from 'lucide-astro';

const lastUpdated = '18 October 2026';
---

<BaseLayout
  title="Privacy Policy | Grace Dieu Priory"
  description="Privacy and data protection policy for The Friends of Grace Dieu Priory (Registered Charity 1117921) and The Grace Dieu Priory Trust."
>
  {/* Hero Header */}
  <section class="bg-ivy-green-dark text-parchment-light py-16 sm:py-20 border-b border-weathered-stone/60 relative overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-candle-gold/20 text-candle-gold border border-candle-gold/40 mb-4 backdrop-blur-xs">
        <ShieldCheck class="w-3.5 h-3.5 text-candle-gold" />
        <span>Data Protection & UK GDPR</span>
      </span>

      <h1 class="font-serif font-bold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight max-w-3xl mb-4">
        Privacy & Data Protection Policy
      </h1>

      <p class="text-lg sm:text-xl text-parchment/90 max-w-2xl leading-relaxed font-normal">
        We are committed to protecting your personal information and being transparent about what data we hold and why.
      </p>

      <div class="text-xs font-mono text-candle-gold-light mt-4">
        Last updated: {lastUpdated} · Registered Charity No. 1117921
      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-12">
    {/* Key Principles Box */}
    <div class="p-6 rounded-2xl bg-card-surface border-2 border-weathered-stone shadow-stone space-y-4">
      <div class="flex items-center gap-2.5">
        <Lock class="w-5 h-5 text-ivy-green" />
        <h2 class="font-serif font-bold text-xl text-deep-ink m-0">
          Our Core Privacy Commitments
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs sm:text-sm">
        <div class="p-3.5 rounded-xl bg-parchment-light border border-weathered-stone/80 space-y-1.5">
          <strong class="text-deep-ink block">Zero Tracking Cookies</strong>
          <span class="text-deep-ink-muted block">We do not employ third-party advertising cookies, trackers, or marketing pixels.</span>
        </div>

        <div class="p-3.5 rounded-xl bg-parchment-light border border-weathered-stone/80 space-y-1.5">
          <strong class="text-deep-ink block">Zero Data Selling</strong>
          <span class="text-deep-ink-muted block">We will never sell, rent, or trade your personal contact details to commercial companies.</span>
        </div>

        <div class="p-3.5 rounded-xl bg-parchment-light border border-weathered-stone/80 space-y-1.5">
          <strong class="text-deep-ink block">Volunteer Care</strong>
          <span class="text-deep-ink-muted block">Information is handled solely by verified charity trustees for official activities.</span>
        </div>
      </div>
    </div>

    {/* Policy Editorial Sections */}
    <div class="space-y-10 text-deep-ink leading-relaxed font-sans text-base sm:text-lg">
      <section class="space-y-3">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl text-deep-ink border-b border-weathered-stone pb-2">
          1. Who We Are
        </h2>
        <p class="text-sm sm:text-base text-deep-ink-muted leading-relaxed">
          This privacy notice applies to personal information collected by <strong>The Friends of Grace Dieu Priory</strong> (Registered Charity No. 1117921) and <strong>The Grace Dieu Priory Trust</strong> (freehold property custodians), Thringstone, Leicestershire. Under the UK Data Protection Act 2018 and the UK General Data Protection Regulation (UK GDPR), we act as the Data Controller.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl text-deep-ink border-b border-weathered-stone pb-2">
          2. The Personal Data We Collect
        </h2>
        <p class="text-sm sm:text-base text-deep-ink-muted leading-relaxed">
          We only collect personal information that you provide directly to us through correspondence, order forms, or volunteer registration. This may include:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-deep-ink-muted">
          <li><strong>Contact Inquiries:</strong> Your name, email address, telephone number, and message content when submitting web forms or emailing officers.</li>
          <li><strong>School & Group Tour Bookings:</strong> School/organisation name, teacher or tour organiser contact details, estimated group size, and special access requirements.</li>
          <li><strong>Publication & Bookstore Orders:</strong> Name, postal delivery address, and contact telephone number required to pack and dispatch books via Royal Mail.</li>
          <li><strong>Volunteer Applications:</strong> Contact details, location, skills, availability, and emergency contact details for physical conservation working parties.</li>
          <li><strong>Charity Membership & Gift Aid:</strong> Name, postal address, and Gift Aid declarations required by HM Revenue & Customs (HMRC) for statutory tax recovery.</li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl text-deep-ink border-b border-weathered-stone pb-2">
          3. How We Use Your Data & Legal Basis
        </h2>
        <p class="text-sm sm:text-base text-deep-ink-muted leading-relaxed">
          We process personal data under the following lawful bases:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-deep-ink-muted">
          <li><strong>Contractual & Direct Requests:</strong> To fulfill publication orders, send postal guides, and arrange guided educational walks that you have requested.</li>
          <li><strong>Legitimate Interests:</strong> To coordinate volunteer working parties, maintain historical records of our site's restoration, and communicate essential AGM notices to members.</li>
          <li><strong>Legal Obligation:</strong> To maintain accounting and Gift Aid records in compliance with charity law and HMRC regulations.</li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl text-deep-ink border-b border-weathered-stone pb-2">
          4. Website Cookies & Technical Tracking
        </h2>
        <p class="text-sm sm:text-base text-deep-ink-muted leading-relaxed">
          Our website is hosted as high-efficiency Static Site Generated (SSG) HTML. We believe in privacy by design:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-deep-ink-muted">
          <li><strong>No Tracking Cookies:</strong> We do not set any tracking, profiling, or targeted marketing cookies on your browser.</li>
          <li><strong>Local Storage:</strong> We use browser <code>localStorage</code> purely to remember your dismissal of the site-wide AGM announcement banner or your gallery filter preferences. No personally identifiable data is stored.</li>
          <li><strong>Embedded Media:</strong> Video embeds (such as Richard Taylor’s YouTube aerial tour) use privacy-friendly click-to-load facades with <code>youtube-nocookie.com</code>, ensuring third-party cookies are blocked until you explicitly click play.</li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl text-deep-ink border-b border-weathered-stone pb-2">
          5. Data Retention & Security
        </h2>
        <p class="text-sm sm:text-base text-deep-ink-muted leading-relaxed">
          We retain personal data only for as long as necessary for the purpose it was gathered:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-deep-ink-muted">
          <li>General email inquiries are archived or deleted once the inquiry has been resolved.</li>
          <li>Book order postal records are maintained until delivery confirmation is complete.</li>
          <li>Gift Aid declarations and financial records are retained for 6 years in accordance with HMRC statutory requirements.</li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl text-deep-ink border-b border-weathered-stone pb-2">
          6. Your Legal Rights
        </h2>
        <p class="text-sm sm:text-base text-deep-ink-muted leading-relaxed">
          Under UK data protection legislation, you possess the right to:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-deep-ink-muted">
          <li>Request a copy of the personal information we hold about you (Subject Access Request).</li>
          <li>Ask us to correct inaccurate or outdated information.</li>
          <li>Request deletion of your information where there is no statutory requirement for us to retain it.</li>
          <li>Withdraw consent for charity communications at any time.</li>
        </ul>
      </section>

      <section class="p-6 rounded-xl bg-parchment-light border border-weathered-stone/80 space-y-2">
        <h3 class="font-serif font-bold text-lg text-deep-ink m-0">
          7. Contacting Us Regarding Your Privacy
        </h3>
        <p class="text-xs sm:text-sm text-deep-ink-muted leading-relaxed m-0">
          If you have questions regarding this policy or wish to exercise your data rights, please contact our Data Protection Officer at:
        </p>
        <div class="pt-2 text-xs sm:text-sm font-mono text-deep-ink font-semibold">
          Email: <a href="mailto:privacy@gracedieupriory.org.uk" class="text-heritage-burgundy hover:underline">privacy@gracedieupriory.org.uk</a> or <a href="mailto:info@gracedieupriory.org.uk" class="text-heritage-burgundy hover:underline">info@gracedieupriory.org.uk</a><br />
          Postal Address: The Friends of Grace Dieu Priory, Thringstone Members Club, Loughborough Road, Thringstone, Leicestershire, LE67 8LR.
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
