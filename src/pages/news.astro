---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import {
  Newspaper,
  Calendar,
  Sparkles,
  ArrowRight,
  ExternalLink,
  Tag,
  ShieldCheck,
  User,
  X,
} from 'lucide-astro';

// Fetch all news items sorted reverse-chronologically
const allNews = await getCollection('news');
const sortedNews = allNews.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const featuredStory = sortedNews.find((n) => n.data.featured) || sortedNews[0];
const regularNews = sortedNews.filter((n) => n.id !== featuredStory.id);

// Category tag styling (quiet, understated pill)
const categoryBadgeClass =
  'text-[11px] font-medium tracking-[0.12em] uppercase px-2.5 py-0.5 rounded-md bg-[#F4F1EA] text-[#3F4E4F] border border-[#E5E0D5]';
---

<BaseLayout
  title="News & Conservation Updates | Grace Dieu Priory"
  description="Latest announcements, archaeological discoveries, volunteer working party updates, and press reports from the Friends of Grace Dieu Priory."
>
  {/* Page Hero Header */}
  <section class="bg-ivy-green-dark text-parchment-light py-16 sm:py-20 border-b border-weathered-stone/60 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img
        src="/images/2024 BBC - Priory Wall exposed.jpg"
        alt="Ancient stone masonry exposed at Grace Dieu Priory"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-candle-gold/20 text-candle-gold border border-candle-gold/40 mb-4 backdrop-blur-xs">
        <Newspaper class="w-3.5 h-3.5 text-candle-gold" />
        <span>Press & Conservation Chronicle</span>
      </span>

      <h1 class="font-serif font-bold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight max-w-3xl mb-4">
        News & Discoveries
      </h1>

      <p class="text-lg sm:text-xl text-parchment/90 max-w-2xl leading-relaxed font-normal">
        Stay informed on masonry conservation, archaeological excavations, community celebrations, and our regional Geopark collaboration.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-16">
    {/* Featured Story Showcase (e.g. 20th Anniversary Medieval Fayre or Land Purchase) */}
    {
      featuredStory && (
        <section class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs uppercase font-mono font-bold text-candle-gold-dark tracking-wider">
              Featured Report
            </span>
            <span class="text-xs text-deep-ink-muted">
              Published {new Date(featuredStory.data.publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
          </div>

          <Card padding="none" class="overflow-hidden bg-white">
            <div class="grid grid-cols-1 lg:grid-cols-12">
              {featuredStory.data.image && (
                <div class="lg:col-span-6 bg-deep-ink h-64 lg:h-auto overflow-hidden relative group">
                  <img
                    src={featuredStory.data.image}
                    alt={featuredStory.data.imageAlt || featuredStory.data.title}
                    class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-deep-ink/60 via-transparent to-transparent"></div>
                </div>
              )}

              <div class="lg:col-span-6 p-6 sm:p-10 lg:p-12 flex flex-col justify-between space-y-6">
                <div class="space-y-3">
                  <div class="flex items-center gap-2">
                    <span class={categoryBadgeClass}>
                      {featuredStory.data.category}
                    </span>
                    {featuredStory.data.source && (
                      <span class="text-xs text-deep-ink-muted font-sans font-medium">
                        Source: {featuredStory.data.source}
                      </span>
                    )}
                  </div>

                  <h2 class="font-serif font-bold text-2xl sm:text-3xl lg:text-4xl text-deep-ink leading-tight">
                    {featuredStory.data.title}
                  </h2>

                  <p class="text-deep-ink leading-relaxed text-sm sm:text-base font-normal">
                    {featuredStory.data.summary}
                  </p>

                  <div class="text-xs sm:text-sm text-deep-ink-muted leading-relaxed line-clamp-3 pt-2">
                    {featuredStory.body ? featuredStory.body.slice(0, 300) + '...' : ''}
                  </div>
                </div>

                <div class="pt-4 border-t border-weathered-stone/60 flex items-center justify-between">
                  <span class="text-xs text-deep-ink-muted flex items-center gap-1.5">
                    <User class="w-3.5 h-3.5 text-ivy-green" />
                    {featuredStory.data.author}
                  </span>

                  <button
                    type="button"
                    class="open-story-btn font-semibold text-xs sm:text-sm text-heritage-burgundy hover:underline cursor-pointer flex items-center gap-1"
                    data-title={featuredStory.data.title}
                    data-date={new Date(featuredStory.data.publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                    data-category={featuredStory.data.category}
                    data-author={featuredStory.data.author}
                    data-image={featuredStory.data.image || ''}
                    data-content={encodeURIComponent(featuredStory.body || '')}
                  >
                    <span>Read Full Story</span>
                    <ArrowRight class="w-4 h-4" />
                  </button>
                </div>
              </div>
            </div>
          </Card>
        </section>
      )
    }

    {/* Section 2: Chronological Editorial Archive Grid */}
    <section class="space-y-8">
      <SectionHeading
        tag="h2"
        eyebrow="Chronicle"
        title="Recent Articles & Milestone Announcements"
        subtitle="Archived articles capturing site ownership, medieval wall excavations, and volunteer community retrospectives."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
        {
          regularNews.map((post) => {
            const formattedDate = new Date(post.data.publishDate).toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'short',
              year: 'numeric',
            });

            return (
              <Card
                padding="none"
                class="flex flex-col justify-between h-full bg-white overflow-hidden group"
              >
                <div>
                  {post.data.image && (
                    <div class="h-48 overflow-hidden bg-parchment-light border-b border-weathered-stone/80">
                      <img
                        src={post.data.image}
                        alt={post.data.imageAlt || post.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                    </div>
                  )}

                  <div class="p-6 space-y-3">
                    <div class="flex items-center justify-between gap-2 text-xs">
                      <span class={categoryBadgeClass}>
                        {post.data.category}
                      </span>
                      <span class="text-deep-ink-muted font-mono">{formattedDate}</span>
                    </div>

                    <h3 class="font-serif font-bold text-xl sm:text-2xl text-deep-ink leading-snug group-hover:text-ivy-green transition-colors">
                      {post.data.title}
                    </h3>

                    <p class="text-sm text-deep-ink-muted leading-relaxed line-clamp-3 m-0">
                      {post.data.summary}
                    </p>
                  </div>
                </div>

                <div class="p-6 pt-0 mt-auto">
                  <div class="pt-4 border-t border-weathered-stone/60 flex items-center justify-between text-xs">
                    <span class="text-deep-ink-light truncate max-w-[150px]">
                      {post.data.source || post.data.author}
                    </span>

                    <button
                      type="button"
                      class="open-story-btn font-semibold text-heritage-burgundy hover:underline cursor-pointer flex items-center gap-1"
                      data-title={post.data.title}
                      data-date={formattedDate}
                      data-category={post.data.category}
                      data-author={post.data.author}
                      data-image={post.data.image || ''}
                      data-content={encodeURIComponent(post.body || '')}
                    >
                      <span>Read Story</span>
                      <ArrowRight class="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              </Card>
            );
          })
        }
      </div>
    </section>
  </div>

  {/* ARTICLE DETAIL MODAL */}
  <div
    id="article-modal"
    class="fixed inset-0 z-50 invisible opacity-0 transition-all duration-300 pointer-events-none flex items-center justify-center p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="article-modal-title"
  >
    <div
      id="article-backdrop"
      class="fixed inset-0 bg-deep-ink/60 backdrop-blur-xs transition-opacity duration-300"
      aria-hidden="true"
    ></div>

    <div
      id="article-panel"
      class="relative w-full max-w-3xl bg-card-surface rounded-2xl border-2 border-weathered-stone shadow-2xl overflow-hidden scale-95 transition-all duration-300 z-10 max-h-[90vh] flex flex-col"
    >
      {/* Modal Top Header */}
      <div class="p-6 border-b border-weathered-stone/80 bg-parchment-light flex items-center justify-between">
        <div>
          <span id="modal-article-category" class="inline-block px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wider bg-ivy-green/10 text-ivy-green border border-ivy-green/20 mb-1">
            Announcement
          </span>
          <div id="modal-article-date" class="text-xs text-deep-ink-muted font-mono"></div>
        </div>

        <button
          type="button"
          id="close-article-btn"
          class="p-2 rounded-lg text-deep-ink-muted hover:text-deep-ink hover:bg-weathered-stone/50 transition-colors cursor-pointer"
          aria-label="Close article"
        >
          <X class="w-6 h-6" />
        </button>
      </div>

      {/* Modal Scrollable Article Body */}
      <div class="p-6 sm:p-8 overflow-y-auto space-y-6">
        <h2 id="modal-article-title" class="font-serif font-bold text-2xl sm:text-3xl text-deep-ink leading-tight m-0"></h2>

        <div id="modal-article-image-box" class="hidden rounded-xl overflow-hidden max-h-72 border border-weathered-stone">
          <img id="modal-article-img" src="" alt="" class="w-full h-full object-cover" />
        </div>

        <div id="modal-article-body" class="prose max-w-none text-deep-ink leading-relaxed text-base space-y-4 font-sans"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function setupNewsModal() {
    const modal = document.getElementById('article-modal');
    const backdrop = document.getElementById('article-backdrop');
    const panel = document.getElementById('article-panel');
    const closeBtn = document.getElementById('close-article-btn');

    const modalTitle = document.getElementById('modal-article-title');
    const modalDate = document.getElementById('modal-article-date');
    const modalCategory = document.getElementById('modal-article-category');
    const modalImageBox = document.getElementById('modal-article-image-box');
    const modalImg = document.getElementById('modal-article-img') as HTMLImageElement;
    const modalBody = document.getElementById('modal-article-body');

    if (!modal || !panel || !backdrop || !closeBtn) return;

    function openArticle(title: string, date: string, category: string, image: string, content: string) {
      if (modalTitle) modalTitle.textContent = title;
      if (modalDate) modalDate.textContent = `Published: ${date}`;
      if (modalCategory) modalCategory.textContent = category.toUpperCase();

      if (image && modalImageBox && modalImg) {
        modalImg.src = image;
        modalImg.alt = title;
        modalImageBox.classList.remove('hidden');
      } else if (modalImageBox) {
        modalImageBox.classList.add('hidden');
      }

      if (modalBody) {
        const decoded = decodeURIComponent(content);
        // Simple markdown paragraph conversion
        const html = decoded
          .split('\n\n')
          .map((p) => {
            const trimmed = p.trim();
            if (trimmed.startsWith('### ')) {
              return `<h3 class="font-serif font-bold text-xl text-deep-ink mt-4 mb-2">${trimmed.replace('### ', '')}</h3>`;
            }
            if (trimmed.startsWith('- ')) {
              const items = trimmed.split('\n- ').map((i) => `<li>${i.replace('- ', '')}</li>`).join('');
              return `<ul class="list-disc pl-5 space-y-1.5 text-deep-ink-muted text-sm sm:text-base my-2">${items}</ul>`;
            }
            return `<p class="text-deep-ink leading-relaxed text-sm sm:text-base my-2">${trimmed.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}</p>`;
          })
          .join('');
        modalBody.innerHTML = html;
      }

      modal.classList.remove('invisible', 'pointer-events-none');
      modal.classList.add('visible', 'pointer-events-auto');

      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        panel.classList.remove('scale-95');
        panel.classList.add('scale-100');
      }, 10);

      document.body.style.overflow = 'hidden';
    }

    function closeArticle() {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      panel.classList.remove('scale-100');
      panel.classList.add('scale-95');

      setTimeout(() => {
        modal.classList.remove('visible', 'pointer-events-auto');
        modal.classList.add('invisible', 'pointer-events-none');
        document.body.style.overflow = '';
      }, 250);
    }

    document.querySelectorAll<HTMLButtonElement>('.open-story-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const title = btn.dataset.title || '';
        const date = btn.dataset.date || '';
        const category = btn.dataset.category || '';
        const image = btn.dataset.image || '';
        const content = btn.dataset.content || '';
        openArticle(title, date, category, image, content);
      });
    });

    closeBtn.addEventListener('click', closeArticle);
    backdrop.addEventListener('click', closeArticle);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeArticle();
    });
  }

  setupNewsModal();
  document.addEventListener('astro:page-load', setupNewsModal);
</script>
