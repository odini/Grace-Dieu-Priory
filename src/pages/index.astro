      </Card>
    </section>
  </div>
</BaseLayout>

{/* Privacy-Friendly Click-to-Load Script */}
<script>
  function setupVideoFacade() {
    const container = document.getElementById('video-facade-container');
    if (!container) return;

    container.addEventListener('click', () => {
      const videoId = container.dataset.videoId;
      if (!videoId) return;

      // Replace facade with privacy-enhanced YouTube iframe
      container.innerHTML = `
        <iframe
          src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1"
          title="Grace Dieu Priory Aerial Flight by Richard Taylor"
          class="w-full h-full border-0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      `;
      container.classList.remove('cursor-pointer');
    });
  }

  setupVideoFacade();
  document.addEventListener('astro:page-load', setupVideoFacade);
</script>
