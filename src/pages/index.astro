            {/* Privacy Badge */}
            <div class="mt-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-black/60 text-candle-gold-light border border-white/20 backdrop-blur-md">
              <ShieldCheck class="w-3.5 h-3.5 text-candle-gold" />
