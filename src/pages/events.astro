---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import DateBadge from '../components/ui/DateBadge.astro';
import {
  Calendar,
  Clock,
  MapPin,
  Users,
  Ticket,
  ArrowRight,
  ExternalLink,
  History,
  CheckCircle2,
  Sparkles,
  Heart,
} from 'lucide-astro';

// Fetch all events from collection
const allEvents = await getCollection('events');
const now = new Date();

// Split into upcoming vs past
const upcomingEvents = allEvents
  .filter((e) => !e.data.archived && new Date(e.data.eventDate).getTime() >= now.getTime() - 86400000)
  .sort((a, b) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime());

const pastEvents = allEvents
  .filter((e) => e.data.archived || new Date(e.data.eventDate).getTime() < now.getTime() - 86400000)
  .sort((a, b) => new Date(b.data.eventDate).getTime() - new Date(a.data.eventDate).getTime());

// Structured JSON-LD Event Schemas
const eventSchemas = upcomingEvents.map((e) => ({
  '@type': 'Event',
  name: e.data.title,
  description: e.data.summary,
  startDate: new Date(e.data.eventDate).toISOString(),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: e.data.location || 'Grace Dieu Priory Ruins',
    address: {
      '@type': 'PostalAddress',
      streetAddress: "Warren Hills Road / Bull's Head trail",
      addressLocality: 'Thringstone',
      addressRegion: 'Leicestershire',
      postalCode: 'LE67 8NR',
      addressCountry: 'GB',
    },
  },
  organizer: {
    '@id': 'https://gracedieupriory.org.uk/#ngo',
  },
  offers: {
    '@type': 'Offer',
    price: e.data.cost ? e.data.cost.replace(/[^0-9.]/g, '') || '0' : '0',
    priceCurrency: 'GBP',
    availability: 'https://schema.org/InStock',
    url: 'https://gracedieupriory.org.uk/events',
  },
}));
---

<BaseLayout
  title="Events & Community Gatherings | Grace Dieu Priory"
  description="Discover upcoming events, historical talks, carol concerts, and annual medieval fayres at Grace Dieu Priory in Leicestershire. Filter upcoming and past archives."
  schema={eventSchemas}
>
  {/* Page Hero Header */}
  <section class="bg-ivy-green-dark text-parchment-light py-16 sm:py-20 border-b border-weathered-stone/60 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img
        src="/images/img5.jpg"
        alt="Re-enactment encampment and visitors at Grace Dieu Priory Medieval Fayre"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-candle-gold/20 text-candle-gold border border-candle-gold/40 mb-4 backdrop-blur-xs">
        <Calendar class="w-3.5 h-3.5 text-candle-gold" />
        <span>Community Calendar</span>
      </span>

      <h1 class="font-serif font-bold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight max-w-3xl mb-4">
        Events & Gatherings
      </h1>

      <p class="text-lg sm:text-xl text-parchment/90 max-w-2xl leading-relaxed font-normal">
        From living history pageantry and choral singing in the cloisters to guided archaeology walks and our Annual General Meeting.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-12">
    {/* Tab Navigation & Social Integration Bar */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-weathered-stone/70">
      {/* Interactive Tabs */}
      <div
        class="inline-flex p-1.5 rounded-xl bg-weathered-stone/40 border border-weathered-stone/80"
        role="tablist"
        aria-label="Events Filter"
      >
        <button
          type="button"
          id="tab-upcoming"
          role="tab"
          aria-selected="true"
          aria-controls="panel-upcoming"
          class="events-tab-btn px-4 sm:px-6 py-2 rounded-lg font-serif font-bold text-sm sm:text-base transition-all duration-200 cursor-pointer bg-card-surface text-deep-ink shadow-sm border border-weathered-stone/60"
        >
          <span>Upcoming Events</span>
          <span class="ml-2 px-2 py-0.5 rounded-full text-xs font-sans font-semibold bg-ivy-green/10 text-ivy-green">
            {upcomingEvents.length}
          </span>
        </button>

        <button
          type="button"
          id="tab-past"
          role="tab"
          aria-selected="false"
          aria-controls="panel-past"
          class="events-tab-btn px-4 sm:px-6 py-2 rounded-lg font-serif font-bold text-sm sm:text-base transition-all duration-200 cursor-pointer text-deep-ink-muted hover:text-deep-ink hover:bg-white/50"
        >
          <span>Past Archive</span>
          <span class="ml-2 px-2 py-0.5 rounded-full text-xs font-sans font-semibold bg-weathered-stone text-deep-ink-muted">
            {pastEvents.length}
          </span>
        </button>
      </div>

      {/* Facebook Link */}
      <div class="flex items-center gap-2">
        <a
          href="https://www.facebook.com/gracedieupriory"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-deep-ink hover:text-heritage-burgundy bg-card-surface px-4 py-2 rounded-lg border border-weathered-stone shadow-xs no-underline transition-colors group"
        >
          <svg class="w-4 h-4 fill-[#1877F2] shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>Join our Facebook Events Group</span>
          <ExternalLink class="w-3.5 h-3.5 text-deep-ink-muted group-hover:text-heritage-burgundy" />
        </a>
      </div>
    </div>

    {/* PANEL 1: UPCOMING EVENTS */}
    <div id="panel-upcoming" role="tabpanel" aria-labelledby="tab-upcoming" class="space-y-8">
      {
        upcomingEvents.length === 0 ? (
          <div class="text-center py-16 bg-card-surface rounded-2xl border border-weathered-stone p-8">
            <Calendar class="w-12 h-12 text-candle-gold-dark mx-auto mb-3" />
            <h3 class="font-serif font-bold text-2xl text-deep-ink">No Scheduled Events Currently</h3>
            <p class="text-deep-ink-muted text-sm max-w-md mx-auto mt-2">
              Check back soon for new dates or keep an eye on our Facebook page for impromptu guided walks.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
              upcomingEvents.map((event) => {
                return (
                  <Card
                    padding="md"
                    class="flex flex-col justify-between h-full bg-white"
                  >
                    <div>
                      {/* Top Bar: DateBadge + Badges */}
                      <div class="flex items-start justify-between gap-3 mb-4">
                        <DateBadge
                          date={event.data.eventDate}
                          size="md"
                          showYear={true}
                          showWeekday={true}
                        />

                        <div class="flex flex-col items-end gap-1.5">
                          <span class="text-[11px] font-medium tracking-[0.12em] uppercase px-2.5 py-0.5 rounded-md bg-[#F4F1EA] text-[#3F4E4F] border border-[#E5E0D5]">
                            {event.data.category}
                          </span>

                          {/* "Volunteers Needed" indicator tag */}
                          {event.data.volunteersNeeded && (
                            <span class="inline-flex items-center gap-1.5 text-[11px] font-medium tracking-wide px-2.5 py-0.5 rounded-md bg-[#7A2E3A]/8 text-[#7A2E3A] border border-[#7A2E3A]/20">
                              <Users class="w-3 h-3 text-[#7A2E3A]" />
                              Volunteers Needed
                            </span>
                          )}
                        </div>
                      </div>

                      {/* Event Title */}
                      <h3 class="font-serif font-bold text-2xl text-deep-ink mb-2">
                        {event.data.title}
                      </h3>

                      {/* Description */}
                      <p class="text-sm text-deep-ink-muted leading-relaxed mb-6">
                        {event.data.description}
                      </p>
                    </div>

                    {/* Metadata Footer */}
                    <div class="pt-4 border-t border-weathered-stone/60 space-y-2 text-xs text-deep-ink-muted mt-auto">
                      <div class="flex items-center justify-between">
                        <span class="font-semibold text-deep-ink flex items-center gap-1.5">
                          <Clock class="w-3.5 h-3.5 text-candle-gold-dark" />
                          {event.data.time}
                        </span>
                        <span class="font-semibold text-candle-gold-dark flex items-center gap-1">
                          <Ticket class="w-3.5 h-3.5" />
                          {event.data.admission}
                        </span>
                      </div>

                      <div class="flex items-center gap-1.5 text-deep-ink-light truncate">
                        <MapPin class="w-3.5 h-3.5 shrink-0" />
                        <span>{event.data.location}</span>
                      </div>

                      {event.data.contactEmail && (
                        <div class="pt-2 flex items-center justify-between">
                          <span class="text-[11px]">Questions?</span>
                          <a
                            href={`mailto:${event.data.contactEmail}?subject=${encodeURIComponent(event.data.title)}`}
                            class="text-heritage-burgundy font-semibold hover:underline"
                          >
                            Contact Organizer ›
                          </a>
                        </div>
                      )}
                    </div>
                  </Card>
                );
              })
            }
          </div>
        )
      }
    </div>

    {/* PANEL 2: PAST ARCHIVE */}
    <div id="panel-past" role="tabpanel" aria-labelledby="tab-past" class="hidden space-y-8">
      <div class="p-4 rounded-xl bg-parchment-light border border-weathered-stone/80 text-sm text-deep-ink-muted flex items-center gap-3">
        <History class="w-5 h-5 text-ivy-green shrink-0" />
        <span>
          Retrospective archive of previous celebrations, public living history camps, and historical lectures held at Grace Dieu Priory.
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          pastEvents.map((event) => (
            <Card padding="md" class="flex flex-col justify-between h-full bg-white">
              <div class="space-y-4">
                <div class="flex items-start justify-between gap-3">
                  <DateBadge date={event.data.eventDate} size="md" variant="ivy" showYear={true} />
                  <span class="text-[11px] font-medium tracking-[0.12em] uppercase px-2.5 py-0.5 rounded-md bg-[#F4F1EA] text-[#3F4E4F] border border-[#E5E0D5]">
                    Past Event
                  </span>
                </div>

                {event.data.image && (
                  <div class="rounded-lg overflow-hidden h-48 border border-weathered-stone/80">
                    <img
                      src={event.data.image}
                      alt={event.data.imageAlt || event.data.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                )}

                <div>
                  <h3 class="font-serif font-bold text-2xl text-deep-ink mb-2">
                    {event.data.title}
                  </h3>
                  <p class="text-sm text-deep-ink-muted leading-relaxed m-0">
                    {event.data.description}
                  </p>
                </div>
              </div>

              <div class="pt-4 border-t border-weathered-stone/60 space-y-2 text-xs text-deep-ink-muted mt-6">
                <div class="flex items-center justify-between">
                  <span>{event.data.time}</span>
                  <span class="font-semibold text-ivy-green">Concluded with Success</span>
                </div>
                <div class="truncate text-deep-ink-light">
                  {event.data.location}
                </div>
              </div>
            </Card>
          ))
        }
      </div>
    </div>

    {/* Bottom Volunteer Callout Banner */}
    <section class="rounded-2xl bg-parchment-light border-2 border-weathered-stone p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center sm:text-left">
        <div class="font-serif font-bold text-2xl text-deep-ink">
          Want to Help Host Our Next Event?
        </div>
        <p class="text-sm text-deep-ink-muted max-w-xl m-0 leading-relaxed">
          We are always looking for volunteer marshals, gazebo setup crew, and car park stewards in Rusty Mary's field. Your support keeps all community events free.
        </p>
      </div>

      <Button variant="primary" href="/get-involved" class="shrink-0 font-bold">
        <Heart class="w-4 h-4" slot="icon-left" />
        <span>Volunteer for Events</span>
      </Button>
    </section>
  </div>
</BaseLayout>

<script>
  function setupEventsTabs() {
    const tabUpcoming = document.getElementById('tab-upcoming');
    const tabPast = document.getElementById('tab-past');
    const panelUpcoming = document.getElementById('panel-upcoming');
    const panelPast = document.getElementById('panel-past');

    if (!tabUpcoming || !tabPast || !panelUpcoming || !panelPast) return;

    function activateTab(activeTab: HTMLElement, inactiveTab: HTMLElement, activePanel: HTMLElement, inactivePanel: HTMLElement) {
      activeTab.setAttribute('aria-selected', 'true');
      activeTab.classList.add('bg-card-surface', 'text-deep-ink', 'shadow-sm', 'border', 'border-weathered-stone/60');
      activeTab.classList.remove('text-deep-ink-muted', 'hover:bg-white/50');

      inactiveTab.setAttribute('aria-selected', 'false');
      inactiveTab.classList.remove('bg-card-surface', 'text-deep-ink', 'shadow-sm', 'border', 'border-weathered-stone/60');
      inactiveTab.classList.add('text-deep-ink-muted', 'hover:bg-white/50');

      activePanel.classList.remove('hidden');
      inactivePanel.classList.add('hidden');
    }

    tabUpcoming.addEventListener('click', () => {
      activateTab(tabUpcoming, tabPast, panelUpcoming, panelPast);
    });

    tabPast.addEventListener('click', () => {
      activateTab(tabPast, tabUpcoming, panelPast, panelUpcoming);
    });
  }

  setupEventsTabs();
  document.addEventListener('astro:page-load', setupEventsTabs);
</script>
