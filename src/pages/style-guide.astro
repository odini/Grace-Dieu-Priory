      {/* 4. WCAG 2.2 AA CONTRAST COMPLIANCE */}
      <section id="contrast" class="scroll-mt-24 space-y-6">
        <SectionHeading
          tag="h2"
          eyebrow="Accessibility Verification"
          title="WCAG 2.2 Level AA / AAA Compliance"
          subtitle="All typography and interactive colors are rigorously verified against the Parchment (#F6F1E7) and Card Surface (#FFFFFF) backdrops."
        />

        <Card padding="none" class="overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm sm:text-base">
              <thead>
                <tr class="bg-parchment-light border-b border-weathered-stone/80 text-deep-ink font-serif font-bold text-base sm:text-lg">
                  <th class="py-3.5 px-4 sm:px-6">Color Pair (FG / BG)</th>
                  <th class="py-3.5 px-4 sm:px-6">Preview Swatch</th>
                  <th class="py-3.5 px-4 sm:px-6">Contrast Ratio</th>
                  <th class="py-3.5 px-4 sm:px-6">WCAG Compliance</th>
                  <th class="py-3.5 px-4 sm:px-6">Intended Application</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-weathered-stone/60 font-sans">
                {
                  contrastAudits.map((item) => (
                    <tr class="hover:bg-parchment-light/60 transition-colors">
                      <td class="py-4 px-4 sm:px-6 font-semibold text-deep-ink">
                        {item.foreground} on {item.background}
                      </td>
                      <td class="py-4 px-4 sm:px-6">
                        <div class="inline-flex items-center gap-2 p-1.5 rounded border border-weathered-stone/80 bg-white">
                          <span class={`w-5 h-5 rounded-full ${item.fgClass} shadow-xs`}></span>
                          <span class="text-xs font-mono font-medium text-deep-ink-muted">vs</span>
                          <span class={`w-5 h-5 rounded-full ${item.bgClass} border border-weathered-stone/60`}></span>
                        </div>
                      </td>
                      <td class="py-4 px-4 sm:px-6 font-mono font-bold text-ivy-green">
                        {item.ratio}
                      </td>
                      <td class="py-4 px-4 sm:px-6">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-ivy-green/10 text-ivy-green border border-ivy-green/20">
                          <CheckCircle2 class="w-3.5 h-3.5" />
                          {item.level}
                        </span>
                      </td>
                      <td class="py-4 px-4 sm:px-6 text-sm text-deep-ink-muted">
                        {item.usage}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <div class="p-6 bg-parchment-light border-t border-weathered-stone/80 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-2 text-sm text-deep-ink-muted">
              <ShieldCheck class="w-5 h-5 text-ivy-green" />
              <span>
                Standard minimum contrast required for normal text is 4.5:1 (AA) and 7:1 (AAA). All core text combinations exceed 7.8:1.
              </span>
            </div>
            <div class="text-xs font-mono text-deep-ink-muted">
              Last Verified: October 2026
            </div>
          </div>
        </Card>
      </section>

