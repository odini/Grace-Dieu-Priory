---
import '../styles/global.css';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import NoticeBanner from '../components/ui/NoticeBanner.astro';
import Card from '../components/ui/Card.astro';
import DateBadge from '../components/ui/DateBadge.astro';
import ContactCard from '../components/ui/ContactCard.astro';
import PriceTag from '../components/ui/PriceTag.astro';
import {
  Calendar,
  Compass,
  ArrowRight,
  ShieldCheck,
  CheckCircle2,
  ExternalLink,
  BookOpen,
  Sparkles,
  HeartHandshake
} from 'lucide-astro';

// WCAG Contrast computation table
const contrastAudits = [
  {
    foreground: 'Deep Ink (#1E211E)',
    background: 'Parchment (#F6F1E7)',
    ratio: '15.2 : 1',
    level: 'AAA (Pass)',
    usage: 'Body text, headings, primary labels',
    fgClass: 'bg-[#1E211E]',
    bgClass: 'bg-[#F6F1E7]',
  },
  {
    foreground: 'Primary Ivy Green (#2F4A3A)',
    background: 'Parchment (#F6F1E7)',
    ratio: '8.2 : 1',
    level: 'AAA (Pass)',
    usage: 'Brand accents, badges, icon containers',
    fgClass: 'bg-[#2F4A3A]',
    bgClass: 'bg-[#F6F1E7]',
  },
  {
    foreground: 'Heritage Burgundy (#7A2E3A)',
    background: 'Parchment (#F6F1E7)',
    ratio: '7.8 : 1',
    level: 'AAA (Pass)',
    usage: 'Text links, interactive elements, button borders',
    fgClass: 'bg-[#7A2E3A]',
    bgClass: 'bg-[#F6F1E7]',
  },
  {
    foreground: 'Parchment Light (#FCFAF6)',
    background: 'Primary Ivy Green (#2F4A3A)',
    ratio: '8.8 : 1',
    level: 'AAA (Pass)',
    usage: 'Primary button text on ivy green fill',
    fgClass: 'bg-[#FCFAF6]',
    bgClass: 'bg-[#2F4A3A]',
  },
  {
    foreground: 'Card Surface White (#FFFFFF)',
    background: 'Heritage Burgundy (#7A2E3A)',
    ratio: '8.8 : 1',
    level: 'AAA (Pass)',
    usage: 'Outline button hover fill text',
    fgClass: 'bg-[#FFFFFF]',
    bgClass: 'bg-[#7A2E3A]',
  },
  {
    foreground: 'Dark Gold Text (#735412)',
    background: 'Parchment (#F6F1E7)',
    ratio: '5.2 : 1',
    level: 'AA (Pass)',
    usage: 'Warning badges, currency accent labels',
    fgClass: 'bg-[#735412]',
    bgClass: 'bg-[#F6F1E7]',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Design System & UI Primitives | Friends of Grace Dieu Priory</title>
    <meta
      name="description"
      content="Historic heritage design system and atomic UI primitives preview for the Friends of Grace Dieu Priory website."
    />
  </head>
  <body class="min-h-screen bg-parchment text-deep-ink selection:bg-candle-gold/30 selection:text-deep-ink">
    {/* Top Header Bar */}
    <header class="border-b border-weathered-stone/80 bg-card-surface/90 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-ivy-green flex items-center justify-center text-parchment-light shadow-sm">
            <Sparkles class="w-5 h-5 text-candle-gold" />
          </div>
          <div>
            <div class="font-serif font-bold text-xl sm:text-2xl text-deep-ink leading-none">
              Grace Dieu Priory
            </div>
            <div class="text-xs uppercase tracking-widest text-deep-ink-muted font-sans font-semibold mt-1">
              Design System & UI Primitives
            </div>
          </div>
        </div>

        <nav class="flex items-center gap-2 sm:gap-4 text-sm font-semibold">
          <a href="#palette" class="no-underline text-deep-ink hover:text-heritage-burgundy px-2 py-1 rounded">
            Palette
          </a>
          <a href="#typography" class="no-underline text-deep-ink hover:text-heritage-burgundy px-2 py-1 rounded">
            Typography
          </a>
          <a href="#components" class="no-underline text-deep-ink hover:text-heritage-burgundy px-2 py-1 rounded">
            Components
          </a>
          <a href="#contrast" class="no-underline text-deep-ink hover:text-heritage-burgundy px-2 py-1 rounded">
            WCAG 2.2 AA
          </a>
        </nav>
      </div>
    </header>

    {/* Main Content Area */}
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16">
      {/* Intro Hero */}
      <section class="max-w-3xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-ivy-green/10 text-ivy-green border border-ivy-green/20 mb-3">
          <ShieldCheck class="w-3.5 h-3.5" />
          Registered Charity No. 1117921
        </span>
        <h1 class="font-serif font-bold text-4xl sm:text-5xl text-deep-ink tracking-tight mb-4">
          Heritage Design System
        </h1>
        <p class="text-lg text-deep-ink-muted leading-relaxed">
          Inspired by 13th-century Augustinian architecture, local Charnwood Forest flora, and medieval manuscript parchment. Every component is engineered for zero-code trustee content management, tactile elegance, and verified WCAG 2.2 AA high legibility.
        </p>
      </section>

      {/* 1. PALETTE */}
      <section id="palette" class="scroll-mt-24 space-y-6">
        <SectionHeading
          tag="h2"
          eyebrow="Color Architecture"
          title="Historic Heritage Palette"
          subtitle="A grounded palette echoing Charnwood stone, ivy-clad medieval arches, and illuminated monastic accounts."
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {/* Ivy Green */}
          <Card padding="sm" class="flex flex-col justify-between">
            <div class="h-24 w-full rounded-md bg-ivy-green mb-3 shadow-inner"></div>
            <div>
              <div class="flex items-center justify-between font-bold text-deep-ink">
                <span>Primary Ivy Green</span>
                <span class="font-mono text-xs text-deep-ink-muted font-normal">#2F4A3A</span>
              </div>
              <p class="text-xs text-deep-ink-muted mt-1 m-0">
                Primary buttons, site hero identity, navigation accents, active borders.
              </p>
            </div>
          </Card>

          {/* Background Parchment */}
          <Card padding="sm" class="flex flex-col justify-between">
            <div class="h-24 w-full rounded-md bg-parchment border border-weathered-stone mb-3 shadow-inner"></div>
            <div>
              <div class="flex items-center justify-between font-bold text-deep-ink">
                <span>Background Parchment</span>
                <span class="font-mono text-xs text-deep-ink-muted font-normal">#F6F1E7</span>
              </div>
              <p class="text-xs text-deep-ink-muted mt-1 m-0">
                Warm, restful page backdrop providing high contrast without clinical harshness.
              </p>
            </div>
          </Card>

          {/* Card Surface */}
          <Card padding="sm" class="flex flex-col justify-between">
            <div class="h-24 w-full rounded-md bg-card-surface border border-weathered-stone mb-3 shadow-inner"></div>
            <div>
              <div class="flex items-center justify-between font-bold text-deep-ink">
                <span>Card Surface</span>
                <span class="font-mono text-xs text-deep-ink-muted font-normal">#FFFFFF</span>
              </div>
              <p class="text-xs text-deep-ink-muted mt-1 m-0">
                Crisp interior surface for elevated cards, modals, and content containers.
              </p>
            </div>
          </Card>

          {/* Weathered Stone */}
          <Card padding="sm" class="flex flex-col justify-between">
            <div class="h-24 w-full rounded-md bg-weathered-stone mb-3 shadow-inner"></div>
            <div>
              <div class="flex items-center justify-between font-bold text-deep-ink">
                <span>Weathered Stone</span>
                <span class="font-mono text-xs text-deep-ink-muted font-normal">#D9D4C7</span>
              </div>
              <p class="text-xs text-deep-ink-muted mt-1 m-0">
                Subtle structural borders, table dividers, card outlines, and badges.
              </p>
            </div>
          </Card>

          {/* Deep Ink */}
          <Card padding="sm" class="flex flex-col justify-between">
            <div class="h-24 w-full rounded-md bg-deep-ink mb-3 shadow-inner"></div>
            <div>
              <div class="flex items-center justify-between font-bold text-deep-ink">
                <span>Deep Ink Text</span>
                <span class="font-mono text-xs text-deep-ink-muted font-normal">#1E211E</span>
              </div>
              <p class="text-xs text-deep-ink-muted mt-1 m-0">
                High-contrast organic body and headline ink avoiding artificial pure black.
              </p>
            </div>
          </Card>

          {/* Heritage Burgundy */}
          <Card padding="sm" class="flex flex-col justify-between">
            <div class="h-24 w-full rounded-md bg-heritage-burgundy mb-3 shadow-inner"></div>
            <div>
              <div class="flex items-center justify-between font-bold text-deep-ink">
                <span>Heritage Burgundy</span>
                <span class="font-mono text-xs text-deep-ink-muted font-normal">#7A2E3A</span>
              </div>
              <p class="text-xs text-deep-ink-muted mt-1 m-0">
                Interactive states, text links, urgent notices, and outline action buttons.
              </p>
            </div>
          </Card>

          {/* Candle Gold */}
          <Card padding="sm" class="flex flex-col justify-between">
            <div class="h-24 w-full rounded-md bg-candle-gold mb-3 shadow-inner"></div>
            <div>
              <div class="flex items-center justify-between font-bold text-deep-ink">
                <span>Divider Candle Gold</span>
                <span class="font-mono text-xs text-deep-ink-muted font-normal">#B8923A</span>
              </div>
              <p class="text-xs text-deep-ink-muted mt-1 m-0">
                Ornamental dividers, focal accents, focus rings, and milestone badges.
              </p>
            </div>
          </Card>
        </div>
      </section>

      {/* 2. TYPOGRAPHY */}
      <section id="typography" class="scroll-mt-24 space-y-6">
        <SectionHeading
          tag="h2"
          eyebrow="Typography Hierarchy"
          title="Editorial Legibility"
          subtitle="Combining the classical elegance of Cormorant Garamond with the clean, modern clarity of Source Sans 3 at minimum 18px base text."
        />

        <Card padding="lg" class="space-y-8">
          <div class="space-y-2 pb-6 border-b border-weathered-stone/60">
            <span class="text-xs font-mono uppercase text-deep-ink-muted">Display H1 · Cormorant Garamond 56px</span>
            <div class="font-serif font-bold text-4xl sm:text-5xl lg:text-6xl text-deep-ink">
              The Augustinian Canonesses of Grace Dieu
            </div>
          </div>

          <div class="space-y-2 pb-6 border-b border-weathered-stone/60">
            <span class="text-xs font-mono uppercase text-deep-ink-muted">Heading H2 · Cormorant Garamond 40px</span>
            <div class="font-serif font-bold text-3xl sm:text-4xl text-deep-ink">
              Conservation of an 800-Year-Old Charnwood Landmark
            </div>
          </div>

          <div class="space-y-2 pb-6 border-b border-weathered-stone/60">
            <span class="text-xs font-mono uppercase text-deep-ink-muted">Heading H3 · Cormorant Garamond 28px</span>
            <div class="font-serif font-semibold text-2xl sm:text-3xl text-deep-ink">
              Dame Petronella’s Household Accounts & Monastic Life
            </div>
          </div>

          <div class="space-y-3">
            <span class="text-xs font-mono uppercase text-deep-ink-muted">Body Text · Source Sans 3 (18px Base / 1.65 Line Height)</span>
            <p class="text-lg text-deep-ink leading-relaxed max-w-3xl">
              Grace Dieu Priory was founded around 1239 by Roesia de Verdun, an independent noblewoman praised by King Henry III. Following the 1538 Dissolution, the priory was transformed into a Tudor estate and later became the birthplace of dramatist Francis Beaumont. Today, the conserved masonry remains accessible free of charge to the public through the voluntary devotion of the Friends of Grace Dieu Priory.
            </p>
            <p class="text-base text-deep-ink-muted">
              Inline link styling example: Learn more about our <a href="#components">reusable UI primitives</a> or review our <a href="#contrast">accessibility compliance report</a>.
            </p>
          </div>
        </Card>
      </section>

      {/* 3. ATOMIC UI PRIMITIVES */}
      <section id="components" class="scroll-mt-24 space-y-12">
        <SectionHeading
          tag="h2"
          eyebrow="Atomic Primitives"
          title="Component Demonstrations"
          subtitle="Fully accessible, zero-dependency components ready for route composition."
        />

        {/* 3.1 Button Primitive */}
        <div class="space-y-4">
          <h3 class="font-serif font-bold text-2xl text-deep-ink">1. Button (`Button.astro`)</h3>
          <p class="text-deep-ink-muted text-base">
            Supports <code>primary</code> (Ivy Green), <code>outline</code> (Heritage Burgundy), and <code>ghost</code> variants across <code>sm</code>, <code>md</code>, and <code>lg</code> sizes with automatic anchor link or button rendering.
          </p>

          <Card padding="md" class="space-y-6">
            <div class="space-y-2">
              <span class="text-xs font-mono text-deep-ink-muted uppercase">Size & Variant Matrix</span>
              <div class="flex flex-wrap items-center gap-4">
                <Button variant="primary" size="lg">
                  <Compass class="w-5 h-5" slot="icon-left" />
                  Plan Your Visit
                </Button>
                <Button variant="outline" size="lg">
                  <BookOpen class="w-5 h-5" slot="icon-left" />
                  Explore History
                </Button>
                <Button variant="ghost" size="lg">
                  Contact Trustees
                  <ArrowRight class="w-5 h-5" slot="icon-right" />
                </Button>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-weathered-stone/60">
              <Button variant="primary" size="md">Primary Ivy Medium</Button>
              <Button variant="outline" size="md">Outline Burgundy Medium</Button>
              <Button variant="ghost" size="md">Ghost Medium</Button>
              <Button variant="primary" size="sm">Primary Small</Button>
              <Button variant="outline" size="sm">Outline Small</Button>
              <Button variant="ghost" size="sm">Ghost Small</Button>
            </div>

            <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-weathered-stone/60">
              <span class="text-xs font-mono text-deep-ink-muted uppercase w-full">Interactive States</span>
              <Button variant="primary" size="md" disabled>Disabled Primary</Button>
              <Button variant="outline" size="md" disabled>Disabled Outline</Button>
              <Button variant="primary" size="md" href="https://gracedieupriory.org.uk" target="_blank">
                External Link Button
                <ExternalLink class="w-4 h-4 ml-1" slot="icon-right" />
              </Button>
            </div>
          </Card>
        </div>

        {/* 3.2 SectionHeading Primitive */}
        <div class="space-y-4">
          <h3 class="font-serif font-bold text-2xl text-deep-ink">2. Section Heading (`SectionHeading.astro`)</h3>
          <p class="text-deep-ink-muted text-base">
            Semantic headings featuring an optional diamond-motif candle-gold divider rule and eyebrow badges.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <Card padding="md">
              <SectionHeading
                tag="h3"
                eyebrow="Guided Tours"
                title="Walks & Educational Talks"
                subtitle="Join local historians exploring the ruins, the Charnwood canal remains, and medieval cloister grounds."
                align="left"
              />
            </Card>

            <Card padding="md">
              <SectionHeading
                tag="h3"
                eyebrow="Community Support"
                title="Volunteer With Us"
                subtitle="Giving just a few hours a year helps keep the gates open and our community heritage thriving."
                align="center"
              />
            </Card>
          </div>
        </div>

        {/* 3.3 NoticeBanner Primitive */}
        <div class="space-y-4">
          <h3 class="font-serif font-bold text-2xl text-deep-ink">3. Notice Banner (`NoticeBanner.astro`)</h3>
          <p class="text-deep-ink-muted text-base">
            Alert banners driven by frontmatter `expiresOn` dates. Supports `info`, `warning`, and `critical` modes with localStorage dismissal persistence.
          </p>

          <div class="space-y-4">
            {/* Critical Policy Banner */}
            <NoticeBanner
              id="paranormal-ban-demo"
              severity="critical"
              title="Strict Policy: Paranormal Events Prohibited"
              message="The Friends of Grace Dieu Priory no longer hold paranormal events or ghost walks. 3rd-party commercial paranormal investigations are expressly forbidden across the entire site by the Grace Dieu Priory Trust."
              dismissible={false}
              actionLink={{
                url: "/visit#site-rules",
                text: "Read Visitor Code of Conduct"
              }}
            />

            {/* Warning Notice */}
            <NoticeBanner
              id="agm-demo"
              severity="warning"
              title="Annual General Meeting - Date Rescheduled"
              message="Please note our AGM will take place at 7:00 PM on Thursday 22nd October in Thringstone Members Club. All members and prospective volunteers are warmly welcomed."
              expiresOn="2026-10-22"
              dismissible={true}
              actionLink={{
                url: "/events/agm-2026",
                text: "View Meeting Agenda"
              }}
            />

            {/* Info Notice */}
            <NoticeBanner
              id="litter-demo"
              severity="info"
              title="Caring for the Ancient Monument"
              message="Please take all litter home with you when visiting the Priory. For dog walkers, a dedicated dog waste bin is located at the Bull's Head car park."
              dismissible={true}
            />

            {/* Expired Banner Test (Will NOT render because expiresOn is in past) */}
            <div class="p-3 bg-weathered-stone/30 rounded-lg text-xs font-mono text-deep-ink-muted">
              <span>Verified Test: Notice with `expiresOn: "2024-01-01"` evaluated:</span>
              <span class="font-bold text-ivy-green ml-2">✓ Safely hidden by Astro server evaluation</span>
              <NoticeBanner
                id="expired-banner-test"
                severity="info"
                title="Past Event Notice (Expired)"
                message="This message should never appear."
                expiresOn="2024-01-01"
              />
            </div>
          </div>
        </div>

        {/* 3.4 Card Primitive */}
        <div class="space-y-4">
          <h3 class="font-serif font-bold text-2xl text-deep-ink">4. Card (`Card.astro`)</h3>
          <p class="text-deep-ink-muted text-base">
            Unified editorial baseline with quiet stone borders and elevation. Top accent borders have been removed across all cards in favour of subtle contextual category tags inside the card body.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <Card padding="md">
              <span class="inline-block text-[11px] font-medium tracking-[0.12em] uppercase px-2.5 py-0.5 rounded-md bg-[#F4F1EA] text-[#3F4E4F] border border-[#E5E0D5] mb-3">
                Archaeology
              </span>
              <h4 class="font-serif font-bold text-xl text-deep-ink mt-1 mb-1">Monastic Archaeology</h4>
              <p class="text-sm text-deep-ink-muted m-0">
                Conserving the newly uncovered 800-year-old Augustinian boundary wall.
              </p>
            </Card>

            <Card padding="md">
              <span class="inline-block text-[11px] font-medium tracking-[0.12em] uppercase px-2.5 py-0.5 rounded-md bg-[#F4F1EA] text-[#3F4E4F] border border-[#E5E0D5] mb-3">
                Geopark
              </span>
              <h4 class="font-serif font-bold text-xl text-deep-ink mt-1 mb-1">Geopark Partnership</h4>
              <p class="text-sm text-deep-ink-muted m-0">
                Proud partners in the Charnwood Forest UNESCO Global Geopark aspiration.
              </p>
            </Card>

            <Card padding="md" href="#components">
              <span class="inline-block text-[11px] font-medium tracking-wide px-2.5 py-0.5 rounded-md bg-[#7A2E3A]/8 text-[#7A2E3A] border border-[#7A2E3A]/20 mb-3">
                Volunteers Needed
              </span>
              <h4 class="font-serif font-bold text-xl text-deep-ink mt-1 mb-1 group-hover:text-heritage-burgundy transition-colors">
                Interactive Link Card
              </h4>
              <p class="text-sm text-deep-ink-muted m-0">
                Smooth lift elevation and hover shadow transition.
              </p>
            </Card>
          </div>
        </div>

        {/* 3.5 DateBadge Primitive */}
        <div class="space-y-4">
          <h3 class="font-serif font-bold text-2xl text-deep-ink">5. Date Badge (`DateBadge.astro`)</h3>
          <p class="text-deep-ink-muted text-base">
            Unified calendar date badge sharing a calm stone/ivy appearance with deep ivy month headers, quiet parchment day containers, and classic serif numbers.
          </p>

          <Card padding="md" class="space-y-6">
            <div class="flex flex-wrap items-center gap-6">
              {/* Event Badge with Year */}
              <div class="flex items-center gap-3">
                <DateBadge date="2026-10-22" size="lg" showYear />
                <div>
                  <div class="font-bold text-deep-ink">AGM 2026</div>
                  <div class="text-xs text-deep-ink-muted">Ivy Header with Year Label</div>
                </div>
              </div>

              {/* Event Badge with Weekday */}
              <div class="flex items-center gap-3">
                <DateBadge date="2026-12-06" size="md" showWeekday />
                <div>
                  <div class="font-bold text-deep-ink">Carols in Cloisters</div>
                  <div class="text-xs text-deep-ink-muted">Ivy Header with Weekday Bar</div>
                </div>
              </div>

              {/* Standard Event Badge */}
              <div class="flex items-center gap-3">
                <DateBadge date="2026-06-28" size="sm" />
                <div>
                  <div class="font-bold text-deep-ink">Medieval Fayre</div>
                  <div class="text-xs text-deep-ink-muted">Standard Compact Date Badge</div>
                </div>
              </div>
            </div>
          </Card>
        </div>

        {/* 3.6 ContactCard Primitive */}
        <div class="space-y-4">
          <h3 class="font-serif font-bold text-2xl text-deep-ink">6. Contact Card (`ContactCard.astro`)</h3>
          <p class="text-deep-ink-muted text-base">
            Role-based layouts protecting volunteer officers from email harvesters with client-side interactive reveal and telephone routing.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <ContactCard
              role="Treasurer & School Tours"
              name="Malcolm Allsop"
              description="Coordinates school educational visits, presentations, tour activities, and charity accounts."
              phone="01530 833 632"
              email="mjandfmallsop4346@sky.com"
              inquiryType="schools"
              featured={true}
            />

            <ContactCard
              role="Publications Officer"
              name="Ann Petty"
              description="Manages all publication mail orders, book distributions, and customer enquiries."
              phone="01530 831895"
              email="annpetty1948@yahoo.co.uk"
              inquiryType="shop"
            />

            <ContactCard
              role="Events & Stewardship"
              name="David Whitt [CONFIRM]"
              description="Leads event volunteer teams, stallholder registrations, and grounds logistics."
              email="events@gracedieupriory.org.uk"
              inquiryType="volunteering"
            />
          </div>
        </div>

        {/* 3.7 PriceTag Primitive */}
        <div class="space-y-4">
          <h3 class="font-serif font-bold text-2xl text-deep-ink">7. Price Tag (`PriceTag.astro`)</h3>
          <p class="text-deep-ink-muted text-base">
            Formatted £ indicators with postage badges, discount strikethroughs, and stock availability indicators.
          </p>

          <Card padding="md">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {/* Reduced book */}
              <div class="p-4 rounded-lg bg-parchment-light border border-weathered-stone/60">
                <span class="text-xs uppercase font-mono text-deep-ink-muted block mb-2">Petronella Account Book</span>
                <PriceTag
                  price={15.00}
