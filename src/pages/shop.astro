---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import PriceTag from '../components/ui/PriceTag.astro';
import NoticeBanner from '../components/ui/NoticeBanner.astro';
import {
  BookOpen,
  Mail,
  Phone,
  Truck,
  CheckCircle2,
  AlertCircle,
  CreditCard,
  Send,
  X,
  ShieldCheck,
  FileText,
  Sparkles,
} from 'lucide-astro';

// Fetch all publications
const publications = await getCollection('publications');
---

<BaseLayout
  title="Publications & Bookstore | Grace Dieu Priory"
  description="Official publications of the Friends of Grace Dieu Priory: Dame Petronella's 1414-1418 Account Book, Walk Around Guide, and More Than Meets The Eye."
>
  {/* Page Hero Header */}
  <section class="bg-ivy-green-dark text-parchment-light py-16 sm:py-20 border-b border-weathered-stone/60 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img
        src="/images/GDP Account Book cover.jpg"
        alt="Historical account book manuscript cover"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-candle-gold/20 text-candle-gold border border-candle-gold/40 mb-4 backdrop-blur-xs">
        <BookOpen class="w-3.5 h-3.5 text-candle-gold" />
        <span>Official Publications & Historical Guides</span>
      </span>

      <h1 class="font-serif font-bold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight max-w-3xl mb-4">
        Priory Publications & Bookstore
      </h1>

      <p class="text-lg sm:text-xl text-parchment/90 max-w-2xl leading-relaxed font-normal">
        From scholarly medieval Latin transcriptions to visitor trail guides and Charnwood biodiversity anthologies. Every book purchased directly supports ongoing stone conservation.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-16">
    {/* Important Ordering & Payment Policy Notice */}
    <div class="p-5 sm:p-6 rounded-2xl bg-[#FCFAF6] border-2 border-candle-gold/40 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-candle-gold/20 flex items-center justify-center text-candle-gold-dark shrink-0 mt-0.5">
          <CreditCard class="w-5 h-5 text-[#8C6B1C]" />
        </div>
        <div class="space-y-1">
          <div class="font-serif font-bold text-lg text-deep-ink">
            Payment & Postal Fulfillment Notice
          </div>
          <p class="text-xs sm:text-sm text-deep-ink-muted leading-relaxed m-0">
            <strong>No direct online credit card processing at this time.</strong> To keep overheads zero, our charity operates on voluntary mail order. Payment is accepted via <strong>cheques payable to "Grace Dieu Priory Trust"</strong> or via bank transfer on request.
          </p>
        </div>
      </div>

      <button
        type="button"
        id="open-general-order-btn"
        class="open-modal-trigger shrink-0 px-5 py-2.5 rounded-lg bg-ivy-green hover:bg-ivy-green-hover text-parchment-light font-semibold text-xs sm:text-sm shadow-xs transition-colors cursor-pointer"
        data-book-title="General Publication Order"
      >
        Order by Post / Email Form ›
      </button>
    </div>

    {/* Section 1: Official Publications Showcase */}
    <section class="space-y-8">
      <SectionHeading
        tag="h2"
        eyebrow="Catalogue"
        title="Official Books & Field Guides"
        subtitle="Explore our trio of published historical works. Click any title to review ordering details or submit a postal dispatch request."
      />

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        {
          publications.map((book) => {
            return (
              <Card
                padding="none"
                class="flex flex-col justify-between h-full bg-white overflow-hidden group"
              >
                <div>
                  {/* Book Cover Image */}
                  <div class="relative h-72 sm:h-80 bg-parchment-light overflow-hidden border-b border-weathered-stone/80 flex items-center justify-center p-4">
                    {book.data.coverImage ? (
                      <img
                        src={book.data.coverImage}
                        alt={book.data.coverImageAlt || book.data.title}
                        class="max-h-full max-w-full object-contain drop-shadow-md group-hover:scale-103 transition-transform duration-300"
                        loading="lazy"
                      />
                    ) : (
                      <BookOpen class="w-16 h-16 text-weathered-stone" />
                    )}

                    {book.data.featured && (
                      <span class="absolute top-3 right-3 text-[11px] font-medium tracking-[0.12em] uppercase px-2.5 py-0.5 rounded-md bg-[#F4F1EA] text-[#3F4E4F] border border-[#E5E0D5] shadow-xs">
                        Featured Work
                      </span>
                    )}
                  </div>

                  {/* Book Details */}
                  <div class="p-6 space-y-4">
                    <div>
                      <div class="text-xs uppercase font-mono text-deep-ink-muted mb-1">
                        {book.data.format} · {book.data.edition || 'Official Edition'}
                      </div>
                      <h3 class="font-serif font-bold text-2xl text-deep-ink leading-snug">
                        {book.data.title}
                      </h3>
                      <p class="text-xs text-deep-ink-light mt-1 font-medium">
                        By {book.data.author}
                      </p>
                    </div>

                    {/* Price and Postage Tag */}
                    <div class="pt-2">
                      <PriceTag
                        price={book.data.price}
                        originalPrice={book.id.includes('petronella') ? 20.00 : undefined}
                        postage={book.data.postage}
                        stockStatus={book.data.stockStatus}
                        size="md"
                      />
                    </div>

                    <p class="text-sm text-deep-ink-muted leading-relaxed line-clamp-4 m-0">
                      {book.body ? book.body.slice(0, 220) + '...' : ''}
                    </p>
                  </div>
                </div>

                {/* Footer Action Card */}
                <div class="p-6 pt-0 mt-auto">
                  <div class="pt-4 border-t border-weathered-stone/60 space-y-3">
                    <button
                      type="button"
                      class="open-modal-trigger w-full px-4 py-3 rounded-lg font-bold text-sm bg-ivy-green hover:bg-ivy-green-hover text-parchment-light transition-colors text-center cursor-pointer shadow-xs focus:outline-none focus:ring-2 focus:ring-candle-gold"
                      data-book-title={book.data.title}
                      data-book-price={`£${book.data.price.toFixed(2)}`}
                      data-book-postage={book.data.postage ? `£${book.data.postage.toFixed(2)}` : 'Free'}
                    >
                      Order by Post / Email Inquiry
                    </button>

                    <div class="text-[11px] text-center text-deep-ink-muted">
                      Sole Supplier: {book.data.supplier} ({book.data.supplierPhone})
                    </div>
                  </div>
                </div>
              </Card>
            );
          })
        }
      </div>
    </section>

    {/* Section 2: Postal Fulfillment Guide */}
    <section class="rounded-2xl border-2 border-weathered-stone bg-card-surface p-6 sm:p-10 shadow-stone">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8 space-y-3">
          <span class="text-xs uppercase font-mono font-bold text-candle-gold-dark">
            Direct Mail Order Instructions
          </span>
          <h2 class="font-serif font-bold text-2xl sm:text-3xl text-deep-ink">
            How to Pay by Cheque or Post
          </h2>
          <p class="text-sm sm:text-base text-deep-ink-muted leading-relaxed m-0">
            To order any of our publications, you may submit the inquiry form above or post your order directly. Please make all cheques payable to <strong>"Grace Dieu Priory Trust"</strong>. Send your order details (book title, quantity, and delivery address) to:
          </p>
          <div class="p-4 rounded-xl bg-parchment-light border border-weathered-stone/80 text-xs sm:text-sm font-sans space-y-1">
            <strong class="text-deep-ink block">Ann Petty · Publications Officer</strong>
            <span class="text-deep-ink-muted block">Sole Supplier for the Friends of Grace Dieu Priory</span>
            <span class="text-deep-ink-muted block">Telephone Inquiries: <strong>01530 831895</strong></span>
            <span class="text-deep-ink-muted block">Email: <code class="font-bold text-deep-ink">annpetty1948@yahoo.co.uk</code> or <code class="font-bold text-deep-ink">shop@gracedieupriory.org.uk</code></span>
          </div>
        </div>

        <div class="md:col-span-4 flex flex-col justify-center space-y-3 text-center sm:text-left">
          <div class="p-4 rounded-xl bg-ivy-green/5 border border-ivy-green/20 space-y-2">
            <ShieldCheck class="w-6 h-6 text-ivy-green" />
            <div class="font-serif font-bold text-lg text-deep-ink">100% Volunteer Fulfilled</div>
            <p class="text-xs text-deep-ink-muted m-0 leading-relaxed">
              Every copy is packed by volunteers. Proceeds directly protect our 13th-century stone arches.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>

  {/* ORDER BY POST / EMAIL MODAL DIALOG */}
  <div
    id="order-modal"
    class="fixed inset-0 z-50 invisible opacity-0 transition-all duration-300 pointer-events-none flex items-center justify-center p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-headline"
  >
    {/* Backdrop Overlay */}
    <div
      id="modal-backdrop"
      class="fixed inset-0 bg-deep-ink/60 backdrop-blur-xs transition-opacity duration-300"
      aria-hidden="true"
    ></div>

    {/* Modal Container */}
    <div
      id="modal-panel"
      class="relative w-full max-w-2xl bg-card-surface rounded-2xl border-2 border-weathered-stone shadow-2xl overflow-hidden scale-95 transition-all duration-300 z-10 max-h-[90vh] flex flex-col"
    >
      {/* Modal Header */}
      <div class="p-6 border-b border-weathered-stone/80 bg-parchment-light flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-ivy-green/10 flex items-center justify-center text-ivy-green shrink-0">
            <BookOpen class="w-5 h-5 text-ivy-green" />
          </div>
          <div>
            <h3 id="modal-headline" class="font-serif font-bold text-2xl text-deep-ink m-0 leading-tight">
              Publication Order / Mail Inquiry
            </h3>
            <p class="text-xs text-deep-ink-muted m-0 mt-0.5">
              Routing directly to <strong class="text-deep-ink">shop@gracedieupriory.org.uk</strong>
            </p>
          </div>
        </div>

        <button
          type="button"
          id="close-modal-btn"
          class="p-2 rounded-lg text-deep-ink-muted hover:text-deep-ink hover:bg-weathered-stone/50 transition-colors cursor-pointer"
          aria-label="Close modal"
        >
          <X class="w-6 h-6" />
        </button>
      </div>

      {/* Modal Body / Form */}
      <div class="p-6 overflow-y-auto space-y-6">
        <div class="p-3.5 rounded-lg bg-candle-gold/10 border border-candle-gold/30 text-xs text-deep-ink-muted flex items-start gap-2.5">
          <AlertCircle class="w-4 h-4 text-[#8C6B1C] shrink-0 mt-0.5" />
          <span>
            <strong>Offline Cheque Policy:</strong> No card numbers required. Please submit your address below to reserve your copy. Cheques are payable to <strong>Grace Dieu Priory Trust</strong>.
          </span>
        </div>

        <form id="book-order-form" class="space-y-4">
          {/* Selected Publication */}
          <div class="space-y-1.5">
            <label for="order-publication" class="block text-xs font-bold uppercase tracking-wider text-deep-ink">
              Selected Publication <span class="text-heritage-burgundy">*</span>
            </label>
            <select
              id="order-publication"
              name="publication"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-weathered-stone bg-white text-deep-ink text-sm focus:outline-none focus:ring-2 focus:ring-candle-gold"
            >
              <option value="Dame Petronella's 1414-1418 Account Book (£15 + £4 p&p)">
                Dame Petronella's 1414-1418 Account Book (£15 + £4 p&p)
              </option>
              <option value="A Walk Around Guide to Grace Dieu Priory (£4.99 + £1.50 p&p)">
                A Walk Around Guide to Grace Dieu Priory (£4.99 + £1.50 p&p)
              </option>
              <option value="More Than Meets The Eye by Woodward & Ikin (£18 + £3.50 p&p)">
                More Than Meets The Eye by Woodward & Ikin (£18 + £3.50 p&p)
              </option>
              <option value="Multiple Publications / Custom Request">
                Multiple Publications / Custom Request
              </option>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="order-name" class="block text-xs font-bold uppercase tracking-wider text-deep-ink">
                Full Name <span class="text-heritage-burgundy">*</span>
              </label>
              <input
                type="text"
                id="order-name"
                name="name"
                required
                placeholder="e.g. John Smith"
                class="w-full px-4 py-2 rounded-lg border border-weathered-stone bg-white text-deep-ink text-sm focus:outline-none focus:ring-2 focus:ring-candle-gold"
              />
            </div>

            <div class="space-y-1.5">
              <label for="order-email" class="block text-xs font-bold uppercase tracking-wider text-deep-ink">
                Email Address <span class="text-heritage-burgundy">*</span>
              </label>
              <input
                type="email"
                id="order-email"
                name="email"
                required
                placeholder="john@example.com"
                class="w-full px-4 py-2 rounded-lg border border-weathered-stone bg-white text-deep-ink text-sm focus:outline-none focus:ring-2 focus:ring-candle-gold"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="order-phone" class="block text-xs font-bold uppercase tracking-wider text-deep-ink">
                Contact Telephone
              </label>
              <input
                type="tel"
                id="order-phone"
                name="phone"
                placeholder="01530 000 000"
                class="w-full px-4 py-2 rounded-lg border border-weathered-stone bg-white text-deep-ink text-sm focus:outline-none focus:ring-2 focus:ring-candle-gold"
              />
            </div>

            <div class="space-y-1.5">
              <label for="order-quantity" class="block text-xs font-bold uppercase tracking-wider text-deep-ink">
                Quantity
              </label>
              <input
                type="number"
                id="order-quantity"
                name="quantity"
                min="1"
                max="10"
                value="1"
                class="w-full px-4 py-2 rounded-lg border border-weathered-stone bg-white text-deep-ink text-sm focus:outline-none focus:ring-2 focus:ring-candle-gold"
              />
            </div>
          </div>

          {/* Delivery Postal Address */}
          <div class="space-y-1.5">
            <label for="order-address" class="block text-xs font-bold uppercase tracking-wider text-deep-ink">
              UK Postal Delivery Address & Postcode <span class="text-heritage-burgundy">*</span>
            </label>
            <textarea
              id="order-address"
              name="address"
              rows="3"
              required
              placeholder="Full postal address including street, town, and UK postcode..."
              class="w-full px-4 py-2 rounded-lg border border-weathered-stone bg-white text-deep-ink text-sm focus:outline-none focus:ring-2 focus:ring-candle-gold"
            ></textarea>
          </div>

          {/* Payment Method Choice */}
          <div class="space-y-2 pt-1">
            <label class="block text-xs font-bold uppercase tracking-wider text-deep-ink">
              Preferred Payment Method
            </label>
            <div class="space-y-2 text-xs">
              <label class="flex items-center gap-2 cursor-pointer text-deep-ink">
                <input
                  type="radio"
                  name="paymentMethod"
                  value="Cheque by Post"
                  checked
                  class="accent-ivy-green"
                />
                <span>I will post a cheque payable to <strong>Grace Dieu Priory Trust</strong></span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-deep-ink">
                <input
                  type="radio"
                  name="paymentMethod"
                  value="Bank Transfer (BACS)"
                  class="accent-ivy-green"
                />
                <span>I would like to pay via BACS Bank Transfer (please email account details)</span>
              </label>
            </div>
          </div>

          {/* Submit */}
          <div class="pt-4 border-t border-weathered-stone/80">
            <Button variant="primary" size="lg" type="submit" fullWidth class="font-bold py-3.5 justify-center">
              <Send class="w-4 h-4 mr-1" slot="icon-left" />
              <span>Submit Order Inquiry</span>
            </Button>
          </div>
        </form>

        {/* Success Confirmation Container */}
        <div id="order-success-msg" class="hidden text-center py-6 space-y-3">
          <div class="w-12 h-12 rounded-full bg-ivy-green/10 text-ivy-green flex items-center justify-center mx-auto">
            <CheckCircle2 class="w-7 h-7" />
          </div>
          <h4 class="font-serif font-bold text-2xl text-deep-ink">Order Inquiry Received</h4>
          <p class="text-sm text-deep-ink-muted max-w-md mx-auto leading-relaxed">
            Your inquiry has been submitted to <strong>shop@gracedieupriory.org.uk</strong>. Ann Petty will contact you to verify stock and provide the postal address for your cheque.
          </p>
          <div class="pt-2">
            <button
              type="button"
              id="order-done-btn"
              class="px-4 py-2 rounded-lg bg-ivy-green text-white text-xs font-semibold cursor-pointer"
            >
              Close Window
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function setupShopModal() {
    const modal = document.getElementById('order-modal');
    const backdrop = document.getElementById('modal-backdrop');
    const panel = document.getElementById('modal-panel');
    const closeBtn = document.getElementById('close-modal-btn');
    const doneBtn = document.getElementById('order-done-btn');
    const form = document.getElementById('book-order-form') as HTMLFormElement;
    const successMsg = document.getElementById('order-success-msg');
    const select = document.getElementById('order-publication') as HTMLSelectElement;

    if (!modal || !panel || !backdrop || !closeBtn) return;

    function openModal(bookTitle?: string) {
      if (select && bookTitle) {
        // Find matching option or default
        for (let i = 0; i < select.options.length; i++) {
          if (select.options[i].value.includes(bookTitle)) {
            select.selectedIndex = i;
            break;
          }
        }
      }

      modal.classList.remove('invisible', 'pointer-events-none');
      modal.classList.add('visible', 'pointer-events-auto');

      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        panel.classList.remove('scale-95');
        panel.classList.add('scale-100');
      }, 10);

      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      panel.classList.remove('scale-100');
      panel.classList.add('scale-95');

      setTimeout(() => {
        modal.classList.remove('visible', 'pointer-events-auto');
        modal.classList.add('invisible', 'pointer-events-none');
        document.body.style.overflow = '';
      }, 250);
    }

    document.querySelectorAll<HTMLButtonElement>('.open-modal-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const title = btn.dataset.bookTitle;
        openModal(title);
      });
    });

    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
    if (doneBtn) doneBtn.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    if (form && successMsg) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const name = fd.get('name');
        const pub = fd.get('publication');
        const addr = fd.get('address');
        const qty = fd.get('quantity');
        const pay = fd.get('paymentMethod');

        const subject = encodeURIComponent(`Book Order: ${pub} - ${name}`);
        const body = encodeURIComponent(
          `Publication: ${pub}\nQuantity: ${qty}\nName: ${name}\nDelivery Address:\n${addr}\nPreferred Payment: ${pay}\n\nSubmitted via gracedieupriory.org.uk/shop`
        );

        form.style.display = 'none';
        successMsg.classList.remove('hidden');

        // Fallback mailto trigger in background
        window.location.href = `mailto:shop@gracedieupriory.org.uk?subject=${subject}&body=${body}`;
      });
    }
  }

  setupShopModal();
  document.addEventListener('astro:page-load', setupShopModal);
</script>
