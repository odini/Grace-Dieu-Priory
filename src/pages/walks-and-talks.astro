---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import DateBadge from '../components/ui/DateBadge.astro';
import {
  Compass,
  GraduationCap,
  Users,
  Calendar,
  BookOpen,
  MapPin,
  Clock,
  Send,
  CheckCircle2,
  Phone,
  Mail,
  ShieldCheck,
  Trees,
  Sparkles,
} from 'lucide-astro';

// Query events collection for walks and talks
const allEvents = await getCollection('events');
const walksAndTalks = allEvents
  .filter((e) => e.data.category === 'walk' || e.data.category === 'talk')
  .sort((a, b) => new Date(b.data.eventDate).getTime() - new Date(a.data.eventDate).getTime());
---

<BaseLayout
  title="Guided Walks & Educational School Visits | Grace Dieu Priory"
  description="Book guided heritage walks, historical talks, and tailored school educational visits at Grace Dieu Priory in Leicestershire. Led by local historians."
>
  {/* Page Hero Header */}
  <section class="bg-ivy-green-dark text-parchment-light py-16 sm:py-20 border-b border-weathered-stone/60 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img
        src="/images/Walk around Guide to Grace Dieu.jpg"
        alt="Woodland footpath leading towards Grace Dieu Priory ruins"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-candle-gold/20 text-candle-gold border border-candle-gold/40 mb-4 backdrop-blur-xs">
        <GraduationCap class="w-3.5 h-3.5 text-candle-gold" />
        <span>Educational Visits & Community Tours</span>
      </span>

      <h1 class="font-serif font-bold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight max-w-3xl mb-4">
        Walks & Educational Talks
      </h1>

      <p class="text-lg sm:text-xl text-parchment/90 max-w-2xl leading-relaxed font-normal">
        From primary school curriculum tours to expert historical lectures, experience 800 years of monastic heritage with our dedicated volunteer historians.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-20">
    {/* Section 1: Upcoming & Recent Walks & Talks */}
    <section class="space-y-8">
      <SectionHeading
        tag="h2"
        eyebrow="Programme"
        title="Scheduled Walks & Historical Lectures"
        subtitle="Explore our seasonal guided tours and academic presentations exploring monastic architecture and female aristocratic fortitude."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          walksAndTalks.map((item) => (
            <Card padding="md" class="flex flex-col justify-between h-full">
              <div class="space-y-4">
                <div class="flex items-start justify-between gap-3">
                  <DateBadge date={item.data.eventDate} size="md" showYear />
                  <span class="text-[11px] font-medium tracking-[0.12em] uppercase px-2.5 py-0.5 rounded-md bg-[#F4F1EA] text-[#3F4E4F] border border-[#E5E0D5]">
                    {item.data.category === 'walk' ? 'Guided Walk' : 'Scholarly Talk'}
                  </span>
                </div>

                <div>
                  <h3 class="font-serif font-bold text-2xl text-deep-ink mb-2">
                    {item.data.title}
                  </h3>
                  <p class="text-sm text-deep-ink-muted leading-relaxed m-0">
                    {item.data.description}
                  </p>
                </div>
              </div>

              <div class="pt-4 border-t border-weathered-stone/60 space-y-2 text-xs text-deep-ink-muted mt-6">
                <div class="flex items-center justify-between">
                  <span class="font-semibold text-deep-ink flex items-center gap-1.5">
                    <Clock class="w-3.5 h-3.5 text-candle-gold-dark" />
                    {item.data.time}
                  </span>
                  <span class="font-medium text-candle-gold-dark">{item.data.admission}</span>
                </div>
                <div class="flex items-center gap-1.5 text-deep-ink-light truncate">
                  <MapPin class="w-3.5 h-3.5 shrink-0" />
                  <span>{item.data.location}</span>
                </div>
              </div>
            </Card>
          ))
        }
      </div>
    </section>

    {/* Section 2: School Educational Visits Detail */}
    <section class="rounded-2xl border-2 border-weathered-stone bg-card-surface p-6 sm:p-10 lg:p-12 shadow-stone space-y-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-ivy-green/10 text-ivy-green border border-ivy-green/20">
          <GraduationCap class="w-4 h-4" />
          <span>Curriculum-Aligned Learning</span>
        </div>

        <h2 class="font-serif font-bold text-3xl sm:text-4xl text-deep-ink">
          School Educational Visits to Grace Dieu Priory
        </h2>

        <p class="text-base sm:text-lg text-deep-ink-muted leading-relaxed m-0">
          Educational visits are tailored to increase awareness of Grace Dieu Priory’s medieval heritage and bring national curriculum history to life in the open air. What could be better than a walk and talk in the fresh air of Charnwood Forest?
        </p>
      </div>

      {/* 3 Pillars of a School Visit */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-xl bg-parchment-light border border-weathered-stone/80 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-ivy-green text-parchment-light flex items-center justify-center font-serif font-bold text-lg">
            1
          </div>
          <h3 class="font-serif font-bold text-xl text-deep-ink">Historical Presentation</h3>
          <p class="text-sm text-deep-ink-muted leading-relaxed m-0">
            An engaging, age-appropriate overview of medieval monastic life, founder Roesia de Verdun, and the 15th-century account books of Prioress Dame Petronella.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-parchment-light border border-weathered-stone/80 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-candle-gold text-deep-ink flex items-center justify-center font-serif font-bold text-lg">
            2
          </div>
          <h3 class="font-serif font-bold text-xl text-deep-ink">Hands-On Activities</h3>
          <p class="text-sm text-deep-ink-muted leading-relaxed m-0">
            Pupils participate in interactive discovery tasks: stone mason mark identification, medieval herbalism scavenger hunts, and architectural reconstruction sketches.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-parchment-light border border-weathered-stone/80 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-heritage-burgundy text-white flex items-center justify-center font-serif font-bold text-lg">
            3
          </div>
          <h3 class="font-serif font-bold text-xl text-deep-ink">Guided Ruins Tour</h3>
          <p class="text-sm text-deep-ink-muted leading-relaxed m-0">
            A comprehensive walking tour of the chapter house, cloisters, Tudor kitchen fireplace, and Grace Dieu brook led by seasoned volunteer educators.
          </p>
        </div>
      </div>

      {/* Coordinator Info */}
      <div class="p-5 rounded-xl bg-ivy-green/5 border border-ivy-green/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="font-serif font-bold text-lg text-deep-ink">School Visits Coordinator</div>
          <div class="text-sm text-deep-ink-muted">
            Coordinated by our Hon. Treasurer, <strong>Malcolm Allsop</strong>. Telephone inquiries: <a href="tel:01530833632" class="font-semibold text-deep-ink hover:text-heritage-burgundy">01530 833 632</a>.
          </div>
        </div>
        <a href="#inquiry-form" class="font-semibold text-sm text-heritage-burgundy hover:underline shrink-0">
          Jump to Booking Inquiry Form ↓
        </a>
      </div>
    </section>

    {/* Section 3: Structured School/Group Inquiry Form */}
    <section id="inquiry-form" class="scroll-mt-24 space-y-8">
      <SectionHeading
        tag="h2"
        eyebrow="Booking Request"
        title="School & Group Visit Inquiry Form"
        subtitle="Submit your proposed visit dates, student numbers, and curriculum requirements. All inquiries are routed directly to our dedicated education desk."
      />

      <Card padding="lg" class="max-w-3xl mx-auto bg-white">
        <form id="school-inquiry-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {/* Field 1: Full Name */}
            <div class="space-y-2">
              <label for="lead-name" class="block text-sm font-semibold text-deep-ink">
                Contact Name <span class="text-heritage-burgundy">*</span>
              </label>
              <input
                type="text"
                id="lead-name"
                name="name"
                required
                placeholder="e.g. Mrs Sarah Jenkins"
                class="w-full px-4 py-2.5 rounded-lg border border-weathered-stone bg-white text-deep-ink placeholder:text-deep-ink-light focus:outline-none focus:ring-2 focus:ring-candle-gold transition-colors text-sm"
              />
            </div>

            {/* Field 2: School / Organization */}
            <div class="space-y-2">
              <label for="school-name" class="block text-sm font-semibold text-deep-ink">
                School or Group Name <span class="text-heritage-burgundy">*</span>
              </label>
              <input
                type="text"
                id="school-name"
                name="school"
                required
                placeholder="e.g. Belton Primary School"
                class="w-full px-4 py-2.5 rounded-lg border border-weathered-stone bg-white text-deep-ink placeholder:text-deep-ink-light focus:outline-none focus:ring-2 focus:ring-candle-gold transition-colors text-sm"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {/* Field 3: Email Address */}
            <div class="space-y-2">
              <label for="lead-email" class="block text-sm font-semibold text-deep-ink">
                Email Address <span class="text-heritage-burgundy">*</span>
              </label>
              <input
                type="email"
                id="lead-email"
                name="email"
                required
                placeholder="teacher@school.sch.uk"
                class="w-full px-4 py-2.5 rounded-lg border border-weathered-stone bg-white text-deep-ink placeholder:text-deep-ink-light focus:outline-none focus:ring-2 focus:ring-candle-gold transition-colors text-sm"
              />
            </div>

            {/* Field 4: Telephone */}
            <div class="space-y-2">
              <label for="lead-phone" class="block text-sm font-semibold text-deep-ink">
                Telephone Number
              </label>
              <input
                type="tel"
                id="lead-phone"
                name="phone"
                placeholder="e.g. 01530 000 000"
                class="w-full px-4 py-2.5 rounded-lg border border-weathered-stone bg-white text-deep-ink placeholder:text-deep-ink-light focus:outline-none focus:ring-2 focus:ring-candle-gold transition-colors text-sm"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {/* Field 5: Estimated Group Size */}
            <div class="space-y-2">
              <label for="group-size" class="block text-sm font-semibold text-deep-ink">
                Estimated Group Size <span class="text-heritage-burgundy">*</span>
              </label>
              <select
                id="group-size"
                name="groupSize"
                required
                class="w-full px-4 py-2.5 rounded-lg border border-weathered-stone bg-white text-deep-ink focus:outline-none focus:ring-2 focus:ring-candle-gold transition-colors text-sm"
              >
                <option value="">Select group size...</option>
                <option value="Under 15 pupils">Small Group (Under 15 pupils)</option>
                <option value="15–30 pupils (1 Class)">1 Class (15–30 pupils)</option>
                <option value="31–60 pupils (2 Classes)">2 Classes (31–60 pupils)</option>
                <option value="60+ pupils">Whole Year Group (60+ pupils)</option>
                <option value="Adult / Walking Group">Adult History or Walking Group</option>
              </select>
            </div>

            {/* Field 6: Preferred Date */}
            <div class="space-y-2">
              <label for="preferred-date" class="block text-sm font-semibold text-deep-ink">
                Preferred Date(s) or Term
              </label>
              <input
                type="text"
                id="preferred-date"
                name="preferredDate"
                placeholder="e.g. Summer Term 2027 or May/June"
                class="w-full px-4 py-2.5 rounded-lg border border-weathered-stone bg-white text-deep-ink placeholder:text-deep-ink-light focus:outline-none focus:ring-2 focus:ring-candle-gold transition-colors text-sm"
              />
            </div>
          </div>

          {/* Field 7: Message */}
          <div class="space-y-2">
            <label for="visit-notes" class="block text-sm font-semibold text-deep-ink">
              Curriculum Goals & Special Requirements <span class="text-heritage-burgundy">*</span>
            </label>
            <textarea
              id="visit-notes"
              name="message"
              rows="4"
              required
              placeholder="Tell us about the year group, topics being studied (e.g. Monasticism, Tudors, Local Geography), and any accessibility considerations..."
              class="w-full px-4 py-2.5 rounded-lg border border-weathered-stone bg-white text-deep-ink placeholder:text-deep-ink-light focus:outline-none focus:ring-2 focus:ring-candle-gold transition-colors text-sm"
            ></textarea>
          </div>

          {/* Role-Based Destination Notice */}
          <div class="p-3.5 rounded-lg bg-parchment-light border border-weathered-stone/70 flex items-center gap-3 text-xs text-deep-ink-muted">
            <ShieldCheck class="w-4 h-4 text-ivy-green shrink-0" />
            <span>
              Inquiries are securely forwarded to our dedicated educational mailbox: <code class="font-bold text-deep-ink">schools@gracedieupriory.org.uk</code>.
            </span>
          </div>

          {/* Submit CTA */}
          <div class="pt-2">
            <Button variant="primary" size="lg" type="submit" fullWidth class="font-bold justify-center py-3.5">
              <Send class="w-4 h-4 mr-1" slot="icon-left" />
              <span>Submit Educational Visit Inquiry</span>
            </Button>
          </div>
        </form>

        {/* Confirmation Message Displayed on Submit */}
        <div id="form-success-message" class="hidden text-center py-8 space-y-4">
          <div class="w-14 h-14 rounded-full bg-ivy-green/10 text-ivy-green flex items-center justify-center mx-auto">
            <CheckCircle2 class="w-8 h-8" />
          </div>
          <h3 class="font-serif font-bold text-2xl text-deep-ink">
            Thank You for Your Inquiry
          </h3>
          <p class="text-sm sm:text-base text-deep-ink-muted max-w-md mx-auto leading-relaxed">
            Your visit request has been routed to <strong>schools@gracedieupriory.org.uk</strong>. Our education team will review your dates and contact you shortly.
          </p>
        </div>
      </Card>
    </section>
  </div>
</BaseLayout>

<script>
  function setupSchoolForm() {
    const form = document.getElementById('school-inquiry-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success-message');

    if (!form || !successMsg) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get('name');
      const school = formData.get('school');
      const groupSize = formData.get('groupSize');
      const preferredDate = formData.get('preferredDate');
      const message = formData.get('message');

      // Create fallback mailto link if user's browser client supports it
      const subject = encodeURIComponent(`School Visit Inquiry: ${school} (${name})`);
      const body = encodeURIComponent(
        `Name: ${name}\nSchool/Group: ${school}\nGroup Size: ${groupSize}\nPreferred Dates: ${preferredDate}\n\nMessage:\n${message}\n\nSubmitted via gracedieupriory.org.uk`
      );

      // Smoothly show confirmation state
      form.style.display = 'none';
      successMsg.classList.remove('hidden');

      // Open mailto fallback in background
      window.location.href = `mailto:schools@gracedieupriory.org.uk?subject=${subject}&body=${body}`;
    });
  }

  setupSchoolForm();
  document.addEventListener('astro:page-load', setupSchoolForm);
</script>
