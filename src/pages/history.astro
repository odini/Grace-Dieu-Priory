---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import {
  Crown,
  BookOpen,
  Calendar,
  Sparkles,
  ShieldCheck,
  ArrowRight,
  MapPin,
  ExternalLink,
  Layers,
  Clock,
  Compass,
  Scroll,
  Quote,
  Feather,
  Hammer,
  KeyRound,
} from 'lucide-astro';

// Era 1: The Monastic Nunnery (1235–1538)
const monasticMilestones = [
  {
    era: 'c. 1235–1241',
    title: 'The Founding of Gratia Dei',
    tag: 'FOUNDING CHARTER',
    desc: 'Rohese (Rose) de Verdon, a powerful Norman-Irish noblewoman holding independent feudal authority, established the priory in the secluded Charnwood valley as an autonomous house of Augustinian canonesses dedicated to God, the Holy Trinity, and St Mary. The earliest recorded prioresses were Agnes de Gresley (1240) and Mary de Stretton (1243), who guided the nascent community through its early material welfare and spiritual foundations.',
    highlight: 'Confirmed by Bishop Robert Grosseteste of Lincoln, granting the nuns independent governance free from external monastic subjection.',
    image: '/images/GDP Stone.webp',
    imageAlt: 'Preserved 13th-century stone carving at Grace Dieu Priory',
  },
  {
    era: '1306',
    title: 'The Forest Gift of John Comyn',
    tag: 'LAND EXPANSION',
    desc: 'John Comyn, Earl of Buchan and Lord of Whitwick, granted the priory 100 acres of newly cleared forest waste situated at Whitwick and Shepshed. This major territorial addition secured valuable woodland pasture, grazing rights, and timber for the canonesses, forming the geographic foundation of the modern priory parkland and ancient woodland footpaths enjoyed today.',
    highlight: 'Established the pastoral estate boundaries that define the secluded Charnwood monument setting.',
  },
  {
    era: '1377',
    title: 'Expansion & The Almonry Hospital',
    tag: 'COMMUNITY CARE',
    desc: 'By 1377, the priory community had expanded to 16 professed canonesses. In keeping with their Augustinian charitable rule, the sisters maintained an almonry hospital within the precinct. The hospital provided shelter, warm meals, and daily hospice care to 12 poor and destitute individuals from the surrounding Charnwood parishes, making the priory an indispensable social lifeline.',
    highlight: 'Provided healthcare and sustenance to 12 destitute local parishioners for nearly two centuries.',
  },
  {
    era: '1414–1418',
    title: 'Dame Petronella’s Account Book',
    tag: 'MANUSCRIPT ARCHIVE',
    desc: 'During the prioress-ship of Dame Petronella, working draft accounts were meticulously kept by Dame Petronella and her assistant Dame Katherine Midleton. Surviving today in the Public Record Office, this 348-page manuscript details tenant rent collections across Leicestershire (including Belton lands generating £21 17s 9d), inventories of pigs and cattle, fish sales from the Belton watermill weir bringing in £6, building repair wages, and food provisions for holy feast days.',
    highlight: 'An internationally celebrated working draft revealing the everyday tangible economic realities of early 15th-century monastic life.',
    image: '/images/GDP Account Book cover.webp',
    imageAlt: 'Cover of Dame Petronella’s 1414-1418 Account Book',
    action: {
      text: 'Order the Published Account Book in our Shop (£15)',
      href: '/shop',
    },
  },
  {
    era: '1535–1538',
    title: 'Valuation, Reprieve & Suppression',
    tag: 'HENRICIAN DISSOLUTION',
    desc: 'In 1535, the priory’s net annual income was assessed at approximately £92. A year later, King Henry VIII’s visiting commissioners, Drs Leigh and Layton, arrived and issued a reduced valuation of £72 13s 4d. Because of this lower threshold, Grace Dieu was slated for closure under the 1536 Act for the Suppression of Lesser Monasteries. Although the priory secured a temporary royal reprieve due to its exemplary reputation, the respite was brief: King Henry VIII’s commissioners formally dissolved the monastery in October 1538.',
    highlight: 'The final prioress, Agnes Litherland, surrendered the priory keys; pensions were granted to fifteen remaining sisters.',
  },
];
---

<BaseLayout
  title="Eight Centuries of Grace Dieu | History & Heritage"
  description="Discover the 800-year history of Grace Dieu Priory: from its 1235 Augustinian nunnery foundation by Rohese de Verdon to the Tudor Beaumont manor, Wordsworth’s poetry, and modern conservation."
>
  {/* Header & Hero Section */}
  <section class="bg-ivy-green-dark text-parchment-light py-16 sm:py-20 border-b border-weathered-stone/60 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img
        src="/images/dji_fly_20261017_114542_0082_1792234392781_photo.webp"
        alt="Aerial vista of the 13th-century Grace Dieu Priory ruins"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-[0.18em] bg-candle-gold/20 text-candle-gold border border-candle-gold/40 mb-4 backdrop-blur-xs">
        <Clock class="w-3.5 h-3.5 text-candle-gold" />
        <span>Chronicle & Archive</span>
      </span>

      <h1 class="font-serif font-bold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight max-w-3xl mb-4">
        Eight Centuries of Grace Dieu
      </h1>

      <p class="text-lg sm:text-xl text-parchment/90 max-w-3xl leading-relaxed font-normal">
        From a secluded Roman-traversed Charnwood valley to a pioneering independent Augustinian nunnery, a Jacobean literary cradle, and a volunteer-rescued monument.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-20">
    {/* Section 1: Lead Narrative & Foundation Highlight Box */}
    <section class="space-y-8">
      {/* Lead Narrative */}
      <div class="max-w-4xl space-y-4">
        <p class="text-lg sm:text-xl text-deep-ink leading-relaxed font-serif">
          Although the land surrounding Grace Dieu possesses ancient heritage connections dating back to the Romans and beyond, the Priory came into being between 1235 and 1241 as a house for Augustinian canonesses. Dedicated to God, the Holy Trinity, and St Mary, it was founded by the remarkable Norman-Irish noblewoman <strong>Rohese (Rose) de Verdon</strong>.
        </p>
        <p class="text-base text-deep-ink-muted leading-relaxed">
          Rose belonged to a prominent feudal dynasty with substantial manorial holdings across Leicestershire and Ireland. Her father, Nicholas de Verdon, had received the lands around Snape from William Wastneis, Lord of Osgathorpe, to extend his deer park at Belton. When no male heir survived, Rose took direct charge of the estates, paying King Henry III a fine to rule in her own right. In the sheltered Charnwood dale along the Grace Dieu Brook, she established a sanctuary of contemplation, hospitality, and prayer.
        </p>
      </div>

      {/* Foundation Highlight Box */}
      <div class="bg-white border border-[#D9D4C7]/80 rounded-2xl p-6 sm:p-8 lg:p-10 shadow-sm relative overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-8 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-candle-gold/15 text-candle-gold-dark border border-candle-gold/30">
              <Scroll class="w-3.5 h-3.5 text-candle-gold-dark" />
              <span>Foundation Charter Confirmation · 1241</span>
            </div>

            <div class="bg-[#F4F0E8] border border-[#E3DDD1] rounded-xl p-5 my-4">
              <blockquote class="font-serif italic text-xl sm:text-2xl text-deep-ink leading-relaxed m-0">
                “The church of the Holy Trinity of the Grace of God at Belton dedicated to God and St Mary”
              </blockquote>
              <p class="text-xs text-[#5C645E] mt-2 mb-0">
                — Confirmation Charter granted by Bishop Robert Grosseteste of Lincoln (1241), giving the priory its enduring epithet <em>Gratia Dei</em> (Grace Dieu).
              </p>
            </div>

            <div class="space-y-3 pt-2 text-sm text-deep-ink-muted leading-relaxed">
              <p>
                Rose endowed the priory with <em>“all my manor of Belton… the park, warren and mills”</em> alongside the Manor of Kirby in Kesteven, Lincolnshire. She was buried upon her death in 1247 in the priory church, and monastic records specify that an annual sum of <strong>12d was dedicated to maintain a perpetual light</strong> burning over her tomb.
              </p>
              <p>
                At the 1538 Dissolution, local parishioners reverently salvaged Rose’s sculpted tomb and effigy, transferring her memorial to the parish church of <strong>St John the Baptist in Belton</strong>, where it remains preserved and admired today.
              </p>
            </div>

            <div class="pt-4 border-t border-weathered-stone/70 flex flex-wrap items-center justify-between gap-4 text-xs sm:text-sm">
              <div class="flex items-center gap-2 text-deep-ink font-semibold">
                <MapPin class="w-4 h-4 text-heritage-burgundy shrink-0" />
                <span>Founder Tomb: St John the Baptist Church, Belton (2 miles away)</span>
              </div>
              <a href="/walks-and-talks" class="text-heritage-burgundy font-bold hover:underline inline-flex items-center gap-1">
                <span>Talks on Rohese de Verdon’s Life</span>
                <span>›</span>
              </a>
            </div>
          </div>

          {/* Stone Relic / Effigy Callout (4 cols) */}
          <div class="lg:col-span-4 bg-[#F6F1E7] border border-[#D9D4C7] rounded-xl p-5 space-y-3">
            <div class="w-full aspect-[4/3] rounded-lg overflow-hidden border border-[#D9D4C7] bg-[#EAE6DE]">
              <img
                src="/images/GDP Stone.webp"
                alt="13th-century carved masonry fragment preserved at Grace Dieu Priory"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div>
              <span class="text-[10px] uppercase font-mono font-bold tracking-wider text-candle-gold-dark block">
                Preserved Relic
              </span>
              <h3 class="font-serif font-bold text-base text-deep-ink m-0">
                13th-Century Carved Ashlar
              </h3>
              <p class="text-xs text-deep-ink-muted leading-relaxed mt-1 m-0">
                Finely chiselled Charnwood stone fragment demonstrating the high quality of early English Gothic craftsmanship achieved by Rose’s masons.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Section 2: Era 1 Timeline: The Monastic Nunnery (1235–1538) */}
    <section class="space-y-8">
      <SectionHeading
        tag="h2"
        eyebrow="ERA I (1235–1538)"
        title="The Augustinian Nunnery"
        subtitle="Three centuries of monastic prayer, agricultural estate management, and community care in the Charnwood valley."
      />

      {/* Alternating Vertical Timeline */}
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        {/* Center Line: desktop dead center, mobile pinned left */}
        <div
          class="left-6 md:left-1/2 -translate-x-1/2 w-0.5 bg-[#D9D4C7] absolute inset-y-0"
          aria-hidden="true"
        ></div>

        <div class="space-y-12 md:space-y-16">
          {
            monasticMilestones.map((item, index) => {
              const isEven = index % 2 === 0;

              return (
                <div class="relative flex items-start w-full">
                  {/* Center Milestone Marker */}
                  <div
                    class="absolute left-6 md:left-1/2 -translate-x-1/2 top-7 w-5 h-5 rounded-full bg-[#F6F1E7] border-2 border-[#B8923A] flex items-center justify-center z-10 shadow-xs"
                    aria-hidden="true"
                  >
                    <span class="w-2 h-2 rounded-full bg-[#2F4A3A]"></span>
                  </div>

                  {/* Milestone Card Wrapper: 45% width on desktop, alternating sides; full width pl-14 on mobile */}
                  <div class={`w-full pl-14 md:pl-0 md:w-[45%] ${isEven ? 'md:mr-auto' : 'md:ml-auto'}`}>
                    <div class="bg-white border border-[#D9D4C7]/70 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
                      {/* Header row */}
                      <div class="flex items-center justify-between gap-3 flex-wrap">
                        <span class="text-xl font-serif font-bold text-[#7A2E3A]">
                          {item.era}
                        </span>
                        <span class="text-[10px] tracking-wider uppercase font-semibold text-[#3F4E4F] bg-[#F4F1EA] px-2.5 py-1 rounded shrink-0">
                          {item.tag}
                        </span>
                      </div>

                      {/* Title */}
                      <h3 class="text-lg font-serif font-semibold text-[#1E211E] mt-2 mb-3">
                        {item.title}
                      </h3>

                      {/* Image (if present) */}
                      {item.image && (
                        <img
                          src={item.image}
                          alt={item.imageAlt || item.title}
                          class="w-full aspect-[16/9] object-cover rounded-lg mb-4 border border-[#E5E0D5]"
                          loading="lazy"
                        />
                      )}

                      {/* Body copy */}
                      <p class="text-sm text-[#3F4E4F] leading-relaxed m-0">
                        {item.desc}
                      </p>

                      {/* Bottom takeaway / quote */}
                      {item.highlight && (
                        <div class="bg-[#FAF8F5] border border-[#D9D4C7]/70 rounded-lg p-3 mt-3">
                          <p class="text-xs text-[#5C645E] italic m-0">
                            ✦ {item.highlight}
                          </p>
                        </div>
                      )}

                      {/* Optional Action link */}
                      {item.action && (
                        <div class="pt-3 mt-3 border-t border-[#D9D4C7]/50">
                          <a
                            href={item.action.href}
                            class="text-xs font-semibold text-[#7A2E3A] hover:text-[#2F4A3A] transition-colors inline-flex items-center gap-1 group"
                          >
                            <span>{item.action.text}</span>
                            <span class="group-hover:translate-x-0.5 transition-transform">›</span>
                          </a>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>
  </div>

  {/* Section 3: Wordsworth Literary Interlude (Full-Width Banner) */}
  <section class="bg-[#F0EBE1] border-y border-[#D9D4C7] py-16 px-6 sm:px-8 my-12">
    <div class="max-w-4xl mx-auto text-center space-y-6">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-[0.16em] bg-[#E2DBD0] text-[#3F4E4F] border border-[#D0C7B9]">
        <Feather class="w-3.5 h-3.5 text-[#7A2E3A]" />
        <span>Romantic Poetry · Coleorton Hall</span>
      </span>

      <blockquote class="font-serif italic text-xl sm:text-2xl lg:text-3xl text-[#1E211E] leading-relaxed max-w-2xl mx-auto">
        “Beneath yon eastern ridge, the craggy bound,<br />
        Rugged and high, of Charnwood’s forest ground,<br />
        Stand yet, but, Stranger, hidden from thy view<br />
        The ivied ruins of forlorn Grace Dieu,<br />
        Erst a religious House, which day and night<br />
        With hymns resounded and the chanted rite.”
      </blockquote>

      <div class="space-y-1">
        <cite class="not-italic text-sm sm:text-base font-serif font-semibold text-[#7A2E3A] block">
          — William Wordsworth
        </cite>
        <p class="text-xs text-[#5C645E] font-medium m-0">
          Written while staying with his friend and patron, Sir George Beaumont, at nearby Coleorton Hall
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-20">
    {/* Section 4: Era 2: The Beaumonts & The Tudor Transformation (1539–1700s) */}
    <section class="space-y-10">
      <SectionHeading
        tag="h2"
        eyebrow="ERA II (1539–1700s)"
        title="The Beaumont Dynasty & The Tudor Mansion"
        subtitle="How royal commissioners, Elizabethan judges, and Jacobean dramatists transformed the sacred cloisters into a literary country seat."
      />

      {/* 3-Part Narrative Profile Cards */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Profile 1: John Beaumont */}
        <div class="bg-white border border-[#D9D4C7]/80 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-[10px] tracking-wider uppercase font-semibold text-[#3F4E4F] bg-[#F4F1EA] px-2.5 py-1 rounded inline-block">
              1534–1552 · SURVEYOR & MASTER
            </span>
            <h3 class="font-serif font-bold text-xl text-deep-ink m-0">
              John Beaumont & The Mansion Conversion
            </h3>
            <p class="text-sm text-deep-ink-muted leading-relaxed">
              Grandson of Thomas Beaumont of Coleorton, John Beaumont was appointed by King’s Writ in January 1534–5 to take the ecclesiastical survey of Leicestershire monasteries. In 1539, after the priory was valued at £125 and granted to the Earl of Huntingdon, it passed to Beaumont.
            </p>
            <p class="text-sm text-deep-ink-muted leading-relaxed">
              Beaumont ingeniously remodeled the nunnery cloisters into a grand Tudor mansion, erecting the massive brick chimneys that still stand. Under Edward VI in 1550 he rose to Master of the Rolls, though financial forfeiture in 1552 briefly cost the family their estates until his widow, Elizabeth Hastings, successfully reclaimed Grace Dieu.
            </p>
          </div>
          <div class="bg-[#FAF8F5] border border-[#D9D4C7]/70 rounded-lg p-3 mt-4">
            <p class="text-xs text-[#5C645E] italic m-0">
              ✦ Transformed the religious house into a courtier’s family residence.
            </p>
          </div>
        </div>

        {/* Profile 2: Francis Beaumont, Justice of Common Pleas */}
        <div class="bg-white border border-[#D9D4C7]/80 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-[10px] tracking-wider uppercase font-semibold text-[#3F4E4F] bg-[#F4F1EA] px-2.5 py-1 rounded inline-block">
              D. 1598 · ELIZABETHAN JUDGE
            </span>
            <h3 class="font-serif font-bold text-xl text-deep-ink m-0">
              Francis Beaumont, Justice of Common Pleas
            </h3>
            <p class="text-sm text-deep-ink-muted leading-relaxed">
              Following Elizabeth’s death in 1588, her eldest son Francis succeeded to the estate. Educated in the law, he became an eminent Elizabethan legal figure and Justice of the Court of Common Pleas, presiding over major judicial circuits.
            </p>
            <p class="text-sm text-deep-ink-muted leading-relaxed">
              He resided continuously at Grace Dieu until his death on April 22, 1598. He and his wife Anne Pierrepoint raised four remarkable children in the cloistered home: Sir Henry, Sir John, Elizabeth, and Francis—nurturing an environment rich in poetry, drama, and classical learning.
            </p>
          </div>
          <div class="bg-[#FAF8F5] border border-[#D9D4C7]/70 rounded-lg p-3 mt-4">
            <p class="text-xs text-[#5C645E] italic m-0">
              ✦ Established Grace Dieu as a distinguished legal and intellectual estate.
            </p>
          </div>
        </div>

        {/* Profile 3: The Jacobean Poets & Dramatists */}
        <div class="bg-white border border-[#D9D4C7]/80 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-[10px] tracking-wider uppercase font-semibold text-[#3F4E4F] bg-[#F4F1EA] px-2.5 py-1 rounded inline-block">
              EARLY 1600s · DRAMA & POETRY
            </span>
            <h3 class="font-serif font-bold text-xl text-deep-ink m-0">
              The Jacobean Poets & Dramatists
            </h3>
            <p class="text-sm text-deep-ink-muted leading-relaxed">
              <strong>Francis Beaumont (1584–1616)</strong> of the Inner Temple became one of England’s most celebrated dramatists, co-authoring 35 renowned plays with John Fletcher for the King’s Men. He died aged 30 and was accorded burial in Poets’ Corner, Westminster Abbey.
            </p>
            <p class="text-sm text-deep-ink-muted leading-relaxed">
              His elder brother, <strong>Sir John Beaumont (1583–1627)</strong>, was created 1st Baronet in 1626 and authored the acclaimed epic poem <em>“Bosworth Field”</em>, celebrating regional history. He is buried in the parish church at Belton.
            </p>
          </div>
          <div class="bg-[#FAF8F5] border border-[#D9D4C7]/70 rounded-lg p-3 mt-4">
            <p class="text-xs text-[#5C645E] italic m-0">
              ✦ Grace Dieu’s sons helped shape English literature in Shakespeare’s era.
            </p>
          </div>
        </div>
      </div>

      {/* The Civil War Decline & Demolition Banner */}
      <div class="bg-white border border-[#D9D4C7]/80 rounded-xl p-6 sm:p-8 shadow-sm space-y-3">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#7A2E3A]">
          <Hammer class="w-4 h-4 text-[#7A2E3A]" />
          <span>The Civil War, Decline & 17th-Century Demolition</span>
        </div>
        <h3 class="font-serif font-bold text-2xl text-deep-ink m-0">
          From Cavalier Tragedy to Romantic Ruin
        </h3>
        <p class="text-sm text-deep-ink-muted leading-relaxed">
          The English Civil War brought tragedy to the Beaumont family. Francis’s grandson, Sir John Beaumont (born 1607), served as a loyal colonel in King Charles I’s army and was slain in battle at the Siege of Gloucester in 1644. His brother Sir Thomas Beaumont lived at Grace Dieu until his death in 1686 (buried at Belton), having eight daughters, which caused the baronetcy to become extinct.
        </p>
        <p class="text-sm text-deep-ink-muted leading-relaxed">
          The estate was sold in 1690 to <strong>Sir Ambrose Phillipps, Knight of Garendon and King’s Serjeant</strong>. Seeking to harvest stone and discourage tenant residence, Phillipps intentionally pulled down the former priory church and dismantled parts of the house. The property passed through his son William, grandson Samuel, and Thomas March Phillipps, while nature gradually reclaimed the stone cloisters with Charnwood ivy.
        </p>
      </div>
    </section>

    {/* Section 5: Era 3: Conservation & Modern Custodianship (1995–Present) */}
    <section class="space-y-10">
      <SectionHeading
        tag="h2"
        eyebrow="ERA III (1995–PRESENT)"
        title="Conservation & Modern Custodianship"
        subtitle="How two decades of voluntary determination saved collapsing masonry and secured permanent ownership for future generations."
      />

      {/* Two-Column Summary Block */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* Column 1: 1995–2006 Rescue */}
        <div class="bg-white border border-[#D9D4C7]/80 rounded-xl p-6 sm:p-8 shadow-sm space-y-4 hover:shadow-md transition-shadow flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-[10px] tracking-wider uppercase font-semibold text-[#3F4E4F] bg-[#F4F1EA] px-2.5 py-1 rounded inline-block">
              1995–2006 · VOLUNTEER SALVATION
            </span>
            <h3 class="font-serif font-bold text-2xl text-deep-ink m-0">
              The 10-Year Emergency Masonry Rescue
            </h3>
            <div class="rounded-lg overflow-hidden aspect-[16/9] border border-[#E5E0D5] my-2">
              <img
                src="/images/grace dieu2.webp"
                alt="Consolidated stone archways of Grace Dieu Priory cleared of ivy"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <p class="text-sm text-deep-ink-muted leading-relaxed">
              By 1995, Grace Dieu was an abandoned pile of stone shrouded in tonnes of choking ivy, saplings, and briars, facing catastrophic collapse. A dedicated group of local residents banded together to save what remained, establishing <strong>The Grace Dieu Priory Charitable Trust</strong>.
            </p>
            <p class="text-sm text-deep-ink-muted leading-relaxed">
              Between 1996 and 2006, master stonemasons and volunteers cleared vegetation, secured failing Gothic arches with lime mortar and stainless steel ties, and consolidated the surviving ruins without synthetic cement. In 2006, the site was officially opened to the public free of charge, with <strong>The Friends of Grace Dieu Priory</strong> (Charity No. 1117921) formed to conduct day-to-day stewardship, educational visits, and guided walks.
            </p>
          </div>
          <div class="bg-[#FAF8F5] border border-[#D9D4C7]/70 rounded-lg p-3 mt-4">
            <p class="text-xs text-[#5C645E] italic m-0">
              ✦ Rescued from total loss entirely through public support, charitable donations, and community volunteer labour.
            </p>
          </div>
        </div>

        {/* Column 2: 2024 Freehold Ownership */}
